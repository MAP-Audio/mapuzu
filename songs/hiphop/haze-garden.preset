ccOut1Sequence":[],"cell6_ccOut2":64.0,"cell6_ccOut2Sequence":[],"cell6_ccOut3":64.0,"cell6_ccOut3Sequence":[],"cell6_ccOut4":64.0,"cell6_ccOut4Sequence":[],"cell6_ccOut5":64.0,"cell6_ccOut6":64.0,"cell6_ccOut7":64.0,"cell6_ccOut8":64.0,"cell6_ccOut9":64.0,"cell6_cellmixEnabled":0.0,"cell6_cellmixMix":50.0,"cell6_cellmixOutputGain":0.0,"cell6_cellmixPan1":0.0,"cell6_cellmixPan2":0.0,"cell6_chaos":0.0,"cell6_chorusDelay":1.08,"cell6_chorusDepth":41.5,"cell6_chorusEnabled":0.0,"cell6_chorusMix":50.0,"cell6_chorusMode":0.0,"cell6_chorusOutputGain":0.0,"cell6_chorusRate":0.36374397312811757,"cell6_chorusSpread":100.0,"cell6_chorusSyncEnabled":0.0,"cell6_chorusTone":7000.0,"cell6_cmfx":"{\"format\":\"cmfx/1\",\"kind\":\"fx\",\"name\":\"Rotary Speaker\",\"description\":\"A rotary speaker cabinet, with a treble horn and a bass drum turning at their own speeds. A tanh preamp feeds a crossover at 800 Hz whose two bands sum back to the input, and two mics pick up the rotors. Speed flips the horn between 0.8 Hz (Slow) and 6.7 Hz (Fast) and the drum between 0.7 and 5.9 Hz, so a 1 kHz tone pulses at the horn's rate and a 200 Hz tone at the drum's. At Ramp 100% the horn reaches 90% of a new speed in 0.8 s speeding up and 1.2 s slowing down, the heavier drum in 4 s and 3 s; Ramp scales those times from 25% to 400%. Drive is the preamp's gain: the third harmonic of a half-scale 200 Hz tone rises from 49 dB down at 0 dB to 15 dB down at 24 dB, while drums keep their level within 1 dB. Depth scales the horn's radius, 18 cm at 100%, whose Doppler swings a 1 kHz tone 37 cents each way at Fast and 4.6 cents at Slow, and how far each rotor's level dips as it turns away: with the mics together at Fast a 3 kHz tone swings 13 dB at the horn's rate and a 200 Hz tone 9 dB at the drum's, and at 0% nothing moves. A back-wall reflection 1.4 ms behind the horn moves the other way. Horn tilts the balance up to 6 dB each way: at +12 dB the horn is 6 dB louder and the drum 6 dB quieter, and at -12 dB the reverse. Width is the angle between the two mics, from 0 degrees (mono) to 180. Wet drums come out within 1 dB of the input at every Drive and Depth, and a limiter and a clip at -0.2 dBFS keep it under full scale.\",\"lineage\":\"f_rotary_speaker\",\"factory\":\"rotary_speaker\",\"retired\":[],\"mix\":1,\"controls\":[{\"slot\":1,\"id\":\"speed\",\"label\":\"Speed\",\"values\":[0.8,6.7],\"labels\":[\"Slow\",\"Fast\"],\"unit\":\"Hz\",\"default\":0.8,\"smooth\":0,\"morph\":\"snap\",\"rand\":[0.8,6.7],\"hint\":\"Slow turns the horn at 0.8 Hz and the drum at 0.7 Hz. Fast turns them at 6.7 and 5.9 Hz\"},{\"slot\":2,\"id\":\"ramp\",\"label\":\"Ramp\",\"min\":25,\"max\":400,\"curve\":\"exp\",\"unit\":\"%\",\"default\":100,\"rand\":[50,200],\"hint\":\"Scales the time each rotor takes to reach 90% of a new speed: at 100% the horn takes 0.8 s up and 1.2 s down, the drum 4 s and 3 s\"},{\"slot\":3,\"id\":\"drive\",\"label\":\"Drive\",\"min\":0,\"max\":24,\"unit\":\"dB\",\"default\":6,\"rand\":[0,15],\"hint\":\"The preamp's gain. It adds harmonics while drums keep their level within 1 dB\"},{\"slot\":4,\"id\":\"horn\",\"label\":\"Horn\",\"min\":-12,\"max\":12,\"unit\":\"dB\",\"default\":0,\"rand\":[-6,6],\"hint\":\"Tilts the balance: at +12 dB the horn is 6 dB louder and the drum 6 dB quieter, and at -12 dB the reverse\"},{\"slot\":5,\"id\":\"depth\",\"label\":\"Depth\",\"min\":0,\"max\":150,\"unit\":\"%\",\"default\":100,\"rand\":[60,130],\"hint\":\"Scales the horn's Doppler and how far each rotor's level dips as it turns away. At 0% nothing moves\"},{\"slot\":6,\"id\":\"width\",\"label\":\"Width\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":60,\"rand\":[30,100],\"hint\":\"The angle between the two mics, from 0 degrees (mono) at 0% to 180 at 100%\"}],\"nodes\":[{\"id\":\"speed\",\"op\":\"param\",\"control\":\"speed\"},{\"id\":\"ramp\",\"op\":\"param\",\"control\":\"ramp\"},{\"id\":\"drive\",\"op\":\"param\",\"control\":\"drive\"},{\"id\":\"horn\",\"op\":\"param\",\"control\":\"horn\"},{\"id\":\"depth\",\"op\":\"param\",\"control\":\"depth\"},{\"id\":\"width\",\"op\":\"param\",\"control\":\"width\"},{\"id\":\"centre\",\"op\":\"mono\"},{\"id\":\"drv_db\",\"op\":\"add\",\"b\":-6.0206},{\"id\":\"drv_g\",\"op\":\"dbtoa\"},{\"id\":\"pre\",\"op\":\"mul\"},{\"id\":\"sat\",\"op\":\"tanh\"},{\"id\":\"mk_lean\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":24,\"out_lo\":1,\"out_hi\":0.712},{\"id\":\"mk_drop\",\"op\":\"mul\"},{\"id\":\"mk_db\",\"op\":\"sub\",\"a\":6.0206},{\"id\":\"mk_g\",\"op\":\"dbtoa\"},{\"id\":\"amp\",\"op\":\"mul\"},{\"id\":\"lp1\",\"op\":\"svf\",\"mode\":\"lp\",\"cutoff\":800,\"q\":0.7071},{\"id\":\"lows\",\"op\":\"svf\",\"mode\":\"lp\",\"cutoff\":800,\"q\":0.7071},{\"id\":\"aligned\",\"op\":\"delay\",\"time\":0.5622,\"max_ms\":1,\"interp\":\"cubic\"},{\"id\":\"highs\",\"op\":\"sub\"},{\"id\":\"h_up\",\"op\":\"mul\",\"b\":3.4744},{\"id\":\"h_dn\",\"op\":\"mul\",\"b\":5.2115},{\"id\":\"d_up\",\"op\":\"mul\",\"b\":17.3718},{\"id\":\"d_dn\",\"op\":\"mul\",\"b\":13.0288},{\"id\":\"horn_hz\",\"op\":\"slide\"},{\"id\":\"drum_set\",\"op\":\"mul\",\"b\":0.88},{\"id\":\"drum_hz\",\"op\":\"slide\"},{\"id\":\"mic\",\"op\":\"mul\",\"b\":0.005},{\"id\":\"horn_ph\",\"op\":\"join\",\"l\":0},{\"id\":\"drum_ph\",\"op\":\"join\",\"r\":0},{\"id\":\"horn_c\",\"op\":\"cycle\"},{\"id\":\"drum_c\",\"op\":\"cycle\"},{\"id\":\"treble\",\"op\":\"onepole\",\"cutoff\":7000},{\"id\":\"h_amt\",\"op\":\"mul\",\"b\":0.0052478},{\"id\":\"h_swing\",\"op\":\"mul\"},{\"id\":\"h_time\",\"op\":\"sub\",\"a\":1},{\"id\":\"h_line\",\"op\":\"delay\",\"max_ms\":3,\"interp\":\"cubic\"},{\"id\":\"h_floor\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":1,\"out_hi\":0.5},{\"id\":\"h_gain\",\"op\":\"scale\",\"in_lo\":-1,\"in_hi\":1,\"out_hi\":1},{\"id\":\"h_dark\",\"op\":\"onepole\",\"cutoff\":2000},{\"id\":\"h_bright\",\"op\":\"sub\"},{\"id\":\"h_beam\",\"op\":\"mul\"},{\"id\":\"h_tone\",\"op\":\"add\"},{\"id\":\"h_out\",\"op\":\"mul\"},{\"id\":\"r_time\",\"op\":\"add\",\"b\":2.4},{\"id\":\"r_line\",\"op\":\"delay\",\"max_ms\":4,\"interp\":\"cubic\"},{\"id\":\"r_near\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":0.4,\"out_hi\":0.16},{\"id\":\"r_gain\",\"op\":\"scale\",\"in_lo\":-1,\"in_hi\":1,\"out_lo\":0.4},{\"id\":\"r_dark\",\"op\":\"onepole\",\"cutoff\":2500},{\"id\":\"r_out\",\"op\":\"mul\"},{\"id\":\"horn_sum\",\"op\":\"add\"},{\"id\":\"d_amt\",\"op\":\"mul\",\"b\":0.0009913},{\"id\":\"d_swing\",\"op\":\"mul\"},{\"id\":\"d_time\",\"op\":\"sub\",\"a\":1},{\"id\":\"d_line\",\"op\":\"delay\",\"max_ms\":2,\"interp\":\"cubic\"},{\"id\":\"d_floor\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":1,\"out_hi\":0.45},{\"id\":\"d_gain\",\"op\":\"scale\",\"in_lo\":-1,\"in_hi\":1,\"out_hi\":1},{\"id\":\"d_dark\",\"op\":\"onepole\",\"cutoff\":250},{\"id\":\"d_bright\",\"op\":\"sub\"},{\"id\":\"d_beam\",\"op\":\"mul\"},{\"id\":\"d_tone\",\"op\":\"add\"},{\"id\":\"d_out\",\"op\":\"mul\"},{\"id\":\"tilt\",\"op\":\"mul\",\"b\":0.5},{\"id\":\"horn_g\",\"op\":\"dbtoa\"},{\"id\":\"untilt\",\"op\":\"mul\",\"b\":-0.5},{\"id\":\"drum_g\",\"op\":\"dbtoa\"},{\"id\":\"horn_lvl\",\"op\":\"mul\"},{\"id\":\"drum_lvl\",\"op\":\"mul\"},{\"id\":\"wet\",\"op\":\"add\"},{\"id\":\"lift\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":150,\"out_lo\":1,\"out_hi\":1.535},{\"id\":\"outg\",\"op\":\"mul\"},{\"id\":\"mag\",\"op\":\"abs\"},{\"id\":\"halves\",\"op\":\"split\"},{\"id\":\"louder\",\"op\":\"max\"},{\"id\":\"env\",\"op\":\"follow\",\"attack\":0.02,\"release\":300},{\"id\":\"floor\",\"op\":\"max\",\"b\":0.89},{\"id\":\"limit\",\"op\":\"div\",\"a\":0.89},{\"id\":\"duck\",\"op\":\"mul\"},{\"id\":\"ceiling\",\"op\":\"clamp\",\"lo\":-0.98,\"hi\":0.98}],\"cables\":[[\"in\",\"centre\"],[\"drive\",\"drv_db\"],[\"drv_db\",\"drv_g\"],[\"centre\",\"pre\"],[\"drv_g\",\"pre.b\"],[\"pre\",\"sat\"],[\"drive\",\"mk_lean\"],[\"drive\",\"mk_drop\"],[\"mk_lean\",\"mk_drop.b\"],[\"mk_drop\",\"mk_db.b\"],[\"mk_db\",\"mk_g\"],[\"sat\",\"amp\"],[\"mk_g\",\"amp.b\"],[\"amp\",\"lp1\"],[\"lp1\",\"lows\"],[\"amp\",\"aligned\"],[\"aligned\",\"highs\"],[\"lows\",\"highs.b\"],[\"ramp\",\"h_up\"],[\"ramp\",\"h_dn\"],[\"ramp\",\"d_up\"],[\"ramp\",\"d_dn\"],[\"speed\",\"horn_hz\"],[\"h_up\",\"horn_hz.up\"],[\"h_dn\",\"horn_hz.down\"],[\"speed\",\"drum_set\"],[\"drum_set\",\"drum_hz\"],[\"d_up\",\"drum_hz.up\"],[\"d_dn\",\"drum_hz.down\"],[\"width\",\"mic\"],[\"mic\",\"horn_ph.r\"],[\"mic\",\"drum_ph.l\"],[\"horn_hz\",\"horn_c.freq\"],[\"horn_ph\",\"horn_c.phase\"],[\"drum_hz\",\"drum_c.freq\"],[\"drum_ph\",\"drum_c.phase\"],[\"highs\",\"treble\"],[\"depth\",\"h_amt\"],[\"horn_c\",\"h_swing\"],[\"h_amt\",\"h_swing.b\"],[\"h_swing\",\"h_time.b\"],[\"treble\",\"h_line\"],[\"h_time\",\"h_line.time\"],[\"depth\",\"h_floor\"],[\"horn_c\",\"h_gain\"],[\"h_floor\",\"h_gain.out_lo\"],[\"h_line\",\"h_dark\"],[\"h_line\",\"h_bright\"],[\"h_dark\",\"h_bright.b\"],[\"h_bright\",\"h_beam\"],[\"h_gain\",\"h_beam.b\"],[\"h_dark\",\"h_tone\"],[\"h_beam\",\"h_tone.b\"],[\"h_tone\",\"h_out\"],[\"h_gain\",\"h_out.b\"],[\"h_swing\",\"r_time\"],[\"treble\",\"r_line\"],[\"r_time\",\"r_line.time\"],[\"depth\",\"r_near\"],[\"horn_c\",\"r_gain\"],[\"r_near\",\"r_gain.out_hi\"],[\"r_line\",\"r_dark\"],[\"r_dark\",\"r_out\"],[\"r_gain\",\"r_out.b\"],[\"h_out\",\"horn_sum\"],[\"r_out\",\"horn_sum.b\"],[\"depth\",\"d_amt\"],[\"drum_c\",\"d_swing\"],[\"d_amt\",\"d_swing.b\"],[\"d_swing\",\"d_time.b\"],[\"lows\",\"d_line\"],[\"d_time\",\"d_line.time\"],[\"depth\",\"d_floor\"],[\"drum_c\",\"d_gain\"],[\"d_floor\",\"d_gain.out_lo\"],[\"d_line\",\"d_dark\"],[\"d_line\",\"d_bright\"],[\"d_dark\",\"d_bright.b\"],[\"d_bright\",\"d_beam\"],[\"d_gain\",\"d_beam.b\"],[\"d_dark\",\"d_tone\"],[\"d_beam\",\"d_tone.b\"],[\"d_tone\",\"d_out\"],[\"d_gain\",\"d_out.b\"],[\"horn\",\"tilt\"],[\"tilt\",\"horn_g\"],[\"horn\",\"untilt\"],[\"untilt\",\"drum_g\"],[\"horn_sum\",\"horn_lvl\"],[\"horn_g\",\"horn_lvl.b\"],[\"d_out\",\"drum_lvl\"],[\"drum_g\",\"drum_lvl.b\"],[\"horn_lvl\",\"wet\"],[\"drum_lvl\",\"wet.b\"],[\"depth\",\"lift\"],[\"wet\",\"outg\"],[\"lift\",\"outg.b\"],[\"outg\",\"mag\"],[\"mag\",\"halves\"],[\"halves.l\",\"louder\"],[\"halves.r\",\"louder.b\"],[\"louder\",\"env\"],[\"env\",\"floor\"],[\"floor\",\"limit.b\"],[\"outg\",\"duck\"],[\"limit\",\"duck.b\"],[\"duck\",\"ceiling\"],[\"ceiling\",\"out\"]],\"ui\":{\"sections\":[{\"label\":\"Amp\",\"widgets\":[{\"type\":\"knob\",\"control\":\"drive\"}]},{\"label\":\"Rotors\",\"widgets\":[{\"type\":\"knob\",\"control\":\"speed\",\"size\":\"l\"},{\"type\":\"knob\",\"control\":\"depth\"},{\"type\":\"knob\",\"control\":\"ramp\"}]},{\"label\":\"Mics\",\"widgets\":[{\"type\":\"knob\",\"control\":\"horn\"},{\"type\":\"knob\",\"control\":\"width\"}]}]}}","cell6_cmfxEnabled":1.0,"cell6_cmfxLayout":"","cell6_cmfxMix":100.0,"cell6_cmfxOutputGain":0.0,"cell6_cmfx_p1":0.25,"cell6_cmfx_p10":0.5,"cell6_cmfx_p11":0.5,"cell6_cmfx_p12":0.5,"cell6_cmfx_p13":0.5,"cell6_cmfx_p14":0.5,"cell6_cmfx_p15":0.5,"cell6_cmfx_p16":0.5,"cell6_cmfx_p17":0.5,"cell6_cmfx_p18":0.5,"cell6_cmfx_p19":0.5,"cell6_cmfx_p2":0.5,"cell6_cmfx_p20":0.5,"cell6_cmfx_p21":0.5,"cell6_cmfx_p22":0.5,"cell6_cmfx_p23":0.5,"cell6_cmfx_p24":0.5,"cell6_cmfx_p3":0.375,"cell6_cmfx_p4":0.5416666666666666,"cell6_cmfx_p5":0.7333333333333333,"cell6_cmfx_p6":0.8,"cell6_cmfx_p7":0.5,"cell6_cmfx_p8":0.5,"cell6_cmfx_p9":0.5,"cell6_cmi":"{\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"name\":\"Jazz Guitar\",\"description\":\"An archtop jazz guitar with flatwound strings and a humbucker at the neck, for warm chords. Pick runs from the thumb at 0, soft and round with no click, to a pick at 100, about 8 dB louder and twice as bright. The string is plucked at 22% of its length from the bridge, and the pickup's two coils read it at 24% and 28%. Flatwound strings carry little above twelve times the note's frequency. While the key is held the note falls 60 dB over Decay at middle C. Let go and it is damped within 150 ms. Tone is the guitar's tone control, a low-pass from 600 Hz to 8 kHz. Body rings the hollow body's air at 110 Hz and its top at 220 Hz under the string: a C3 is about 7 dB louder at 100 than at 0. Six voices. A note peaks between -19 and -8 dBFS from C2 to C6, louder low, and a harder strike is louder and brighter.\",\"lineage\":\"i_jazz_guitar\",\"factory\":\"jazz_guitar\",\"retired\":[],\"voices\":6,\"controls\":[{\"slot\":1,\"id\":\"pick\",\"label\":\"Pick\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":20,\"rand\":[0,70],\"hint\":\"From the thumb, soft and round with no click, to a pick, brighter and with a click\"},{\"slot\":2,\"id\":\"decay\",\"label\":\"Decay\",\"min\":400,\"max\":6000,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":1800,\"rand\":[900,4000],\"hint\":\"Time for a held note to fall 60 dB, at middle C\"},{\"slot\":3,\"id\":\"tone\",\"label\":\"Tone\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":40,\"rand\":[15,75],\"hint\":\"The tone control, a low-pass from 600 Hz to 8 kHz\"},{\"slot\":4,\"id\":\"body\",\"label\":\"Body\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":50,\"rand\":[20,90],\"hint\":\"How much the hollow body rings at 110 Hz and 220 Hz under the string\"}],\"nodes\":[{\"id\":\"pick\",\"op\":\"param\",\"control\":\"pick\"},{\"id\":\"decay\",\"op\":\"param\",\"control\":\"decay\"},{\"id\":\"tone\",\"op\":\"param\",\"control\":\"tone\"},{\"id\":\"body\",\"op\":\"param\",\"control\":\"body\"},{\"id\":\"hz\",\"op\":\"note\",\"base\":48},{\"id\":\"rate_sr\",\"op\":\"sr\"},{\"id\":\"hit\",\"op\":\"trig\"},{\"id\":\"held\",\"op\":\"gate\"},{\"id\":\"vel\",\"op\":\"velocity\"},{\"id\":\"period\",\"op\":\"div\"},{\"id\":\"scratch\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":0,\"out_hi\":0.1},{\"id\":\"pick_oct\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":-0.5,\"out_hi\":3.5},{\"id\":\"vel_oct\",\"op\":\"scale\",\"out_lo\":-1.5,\"out_hi\":0.5},{\"id\":\"picked\",\"op\":\"add\"},{\"id\":\"pick_ratio\",\"op\":\"exp2\"},{\"id\":\"pick_hz\",\"op\":\"mul\"
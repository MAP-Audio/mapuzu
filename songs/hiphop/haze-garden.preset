:0.0,"cell3_synthWaveCurve":[],"cell3_synthWaveFm":0.0,"cell3_synthWaveMode":0.0,"cell3_synth_p1":0.5,"cell3_synth_p2":0.5,"cell3_synth_p3":0.5,"cell3_synth_p4":0.5,"cell3_synth_p5":0.5,"cell3_synth_p6":0.5,"cell3_synth_p7":0.5,"cell3_synth_p8":0.5,"cell3_tablefilterAnchor":440.0,"cell3_tablefilterAsset":{"binCount":1024.0,"ceilingDb":12.0,"data":"","encoding":"u16le-logmag-base64","floorDb":-72.0,"format":"pam-table-response","frameCount":64.0,"id":"factory:harmonic:Harmonic","interpretation":"harmonic","name":"Harmonic","source":{"displayName":"Harmonic","kind":"factory"},"version":1.0},"cell3_tablefilterAssetId":"factory:harmonic:Harmonic","cell3_tablefilterDepth":100.0,"cell3_tablefilterEnabled":0.0,"cell3_tablefilterFrame":0.0,"cell3_tablefilterMix":100.0,"cell3_tablefilterOutputGain":0.0,"cell3_tablefilterResonance":100.0,"cell3_tablefilterSmooth":15.0,"cell3_tapeDrive":50.0,"cell3_tapeEnabled":0.0,"cell3_tapeMix":100.0,"cell3_tapeMode":0.0,"cell3_tapeOutputGain":0.0,"cell3_tapeTone":0.0,"cell3_tapeWear":50.0,"cell3_tempoSync":0.0,"cell3_transientAttack":0.0,"cell3_transientEnabled":0.0,"cell3_transientHarmonic":100.0,"cell3_transientOther":100.0,"cell3_transientOutputGain":0.0,"cell3_transientPercussive":100.0,"cell3_transientSpeed":1.0,"cell3_transientSplitMode":1.0,"cell3_transientSustain":0.0,"cell3_vcaDepth":0.0,"cell3_vinylbrakeCurve":0.0,"cell3_vinylbrakeEnabled":1.0,"cell3_vinylbrakeEngage":0.0,"cell3_vinylbrakeMix":100.0,"cell3_vinylbrakeMode":0.0,"cell3_vinylbrakeOutputGain":0.0,"cell3_vinylbrakeQuantize":0.0,"cell3_vinylbrakeRise":0.4249399170492218,"cell3_vinylbrakeScratch":0.0,"cell3_vinylbrakeSlow":0.8,"cell3_vinylbrakeSyncEnabled":0.0,"cell3_vocoderEnabled":0.0,"cell3_vocoderFormant":0.0,"cell3_vocoderMix":100.0,"cell3_vocoderNote":60.0,"cell3_vocoderOutputGain":0.0,"cell3_vocoderSpeed":1.0,"cell3_vocoderWave":0.0,"cell3_vocoderWidth":100.0,"cell3_volume":8.0,"cell3_wavefoldAmount":0.0,"cell3_wavefoldDrive":0.0,"cell3_wavefoldEnabled":0.0,"cell3_wavefoldMix":100.0,"cell3_wavefoldMotion":0.0,"cell3_wavefoldOutputGain":0.0,"cell3_wavefoldSymmetry":0.0,"cell3_wavefoldTexture":0.0,"cell4_arpeg":0.0,"cell4_arpegMode":0.0,"cell4_ccOut1":64.0,"cell4_ccOut10":64.0,"cell4_ccOut11":64.0,"cell4_ccOut12":64.0,"cell4_ccOut13":64.0,"cell4_ccOut14":64.0,"cell4_ccOut15":64.0,"cell4_ccOut16":64.0,"cell4_ccOut1Sequence":[],"cell4_ccOut2":64.0,"cell4_ccOut2Sequence":[],"cell4_ccOut3":64.0,"cell4_ccOut3Sequence":[],"cell4_ccOut4":64.0,"cell4_ccOut4Sequence":[],"cell4_ccOut5":64.0,"cell4_ccOut6":64.0,"cell4_ccOut7":64.0,"cell4_ccOut8":64.0,"cell4_ccOut9":64.0,"cell4_cellmixEnabled":0.0,"cell4_cellmixMix":50.0,"cell4_cellmixOutputGain":0.0,"cell4_cellmixPan1":0.0,"cell4_cellmixPan2":0.0,"cell4_chaos":0.0,"cell4_chorusDelay":1.08,"cell4_chorusDepth":41.5,"cell4_chorusEnabled":0.0,"cell4_chorusMix":50.0,"cell4_chorusMode":0.0,"cell4_chorusOutputGain":0.0,"cell4_chorusRate":0.36374397312811757,"cell4_chorusSpread":100.0,"cell4_chorusSyncEnabled":0.0,"cell4_chorusTone":7000.0,"cell4_cmfx":"{\"format\":\"cmfx/1\",\"kind\":\"fx\",\"name\":\"Spring Reverb\",\"description\":\"A two-spring reverb tank, where every echo is a chirp falling from treble to bass. Each spring is a delay loop through 48 allpasses that hold the bass back. The left spring's echoes start every Length ms and the right spring's every 1.1 times that. Decay is the time the tail takes to fall 60 dB, from 0.5 to 8 s, and the input is scaled down as it grows; a high-pass in each loop makes the bass die faster than the treble, as a tank's does. Tension sets how far each echo's bass trails its treble: with Drip at 0 and Length at 60 ms, the first echo's bass peaks 18 ms after its treble at 50% and 35 ms after at 100%. Tone sets the loop's low-pass from 2.5 to 6.5 kHz. Drip high-passes the input from 40 to 400 Hz for a thinner, drippier tank. Width spreads the two springs from mono to wider than the input. Wet drums come out within 3 dB of the dry at the defaults, under full scale.\",\"lineage\":\"f_spring_reverb\",\"factory\":\"spring_reverb\",\"retired\":[],\"mix\":0.35,\"controls\":[{\"slot\":1,\"id\":\"decay\",\"label\":\"Decay\",\"min\":0.5,\"max\":8,\"curve\":\"exp\",\"unit\":\"s\",\"default\":2.5,\"rand\":[1,5],\"hint\":\"Time the tail takes to fall 60 dB. The bass dies faster than the treble, as a tank's does\"},{\"slot\":2,\"id\":\"tension\",\"label\":\"Tension\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":50,\"rand\":[20,85],\"hint\":\"How far each echo's bass trails its treble\"},{\"slot\":3,\"id\":\"length\",\"label\":\"Length\",\"min\":25,\"max\":60,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":36,\"rand\":[28,50],\"hint\":\"The left spring's echoes start this far apart, the right spring's 1.1 times as far\"},{\"slot\":4,\"id\":\"tone\",\"label\":\"Tone\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":50,\"rand\":[20,85],\"hint\":\"The loop's low-pass, from 2.5 kHz at 0% to 6.5 kHz at 100%\"},{\"slot\":5,\"id\":\"drip\",\"label\":\"Drip\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":20,\"rand\":[0,70],\"hint\":\"High-passes the input from 40 Hz at 0% to 400 Hz at 100%, for a thinner, drippier tank\"},{\"slot\":6,\"id\":\"width\",\"label\":\"Width\",\"min\":0,\"max\":150,\"unit\":\"%\",\"default\":100,\"rand\":[60,140],\"hint\":\"Spreads the two springs from mono to wider than the input\"}],\"nodes\":[{\"id\":\"decay\",\"op\":\"param\",\"control\":\"decay\"},{\"id\":\"tension\",\"op\":\"param\",\"control\":\"tension\"},{\"id\":\"length\",\"op\":\"param\",\"control\":\"length\"},{\"id\":\"tone\",\"op\":\"param\",\"control\":\"tone\"},{\"id\":\"drip\",\"op\":\"param\",\"control\":\"drip\"},{\"id\":\"width\",\"op\":\"param\",\"control\":\"width\"},{\"id\":\"centre\",\"op\":\"mono\"},{\"id\":\"drip_oct\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":5.32193,\"out_hi\":8.64386},{\"id\":\"drip_hz\",\"op\":\"exp2\"},{\"id\":\"thin\",\"op\":\"svf\",\"mode\":\"hp\",\"q\":0.6},{\"id\":\"spans\",\"op\":\"join\",\"
,\"control\":\"b5k\"},{\"type\":\"knob\",\"control\":\"b12k\"}]}]}}","cell5_cmfxEnabled":1.0,"cell5_cmfxLayout":"","cell5_cmfxMix":100.0,"cell5_cmfxOutputGain":0.0,"cell5_cmfx_p1":0.625,"cell5_cmfx_p10":0.5,"cell5_cmfx_p11":0.5,"cell5_cmfx_p12":0.5,"cell5_cmfx_p13":0.5,"cell5_cmfx_p14":0.5,"cell5_cmfx_p15":0.5,"cell5_cmfx_p16":0.5,"cell5_cmfx_p17":0.5,"cell5_cmfx_p18":0.5,"cell5_cmfx_p19":0.5,"cell5_cmfx_p2":0.6875,"cell5_cmfx_p20":0.5,"cell5_cmfx_p21":0.5,"cell5_cmfx_p22":0.5,"cell5_cmfx_p23":0.5,"cell5_cmfx_p24":0.5,"cell5_cmfx_p3":0.5,"cell5_cmfx_p4":0.375,"cell5_cmfx_p5":0.5625,"cell5_cmfx_p6":0.25,"cell5_cmfx_p7":0.125,"cell5_cmfx_p8":0.5,"cell5_cmfx_p9":0.5,"cell5_cmi":"{\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"name\":\"Soul Bass\",\"description\":\"A fingered electric bass with flatwound strings and a foam mute under them at the bridge: the deep, short thud of 60s soul records. Touch runs from the thumb at 0, plucked at 30% of the string from the bridge and soft, to a fingertip at 100, plucked at 12% and brighter. Mute is the foam: at 0 a held note falls 60 dB over Decay, and at 100 within 300 ms, darker as it rises. Tone is the tone control, a low-pass from 250 Hz to 4 kHz. Let go and the note is damped within 150 ms. One voice, so a new note strikes the string again. Key 48 plays C2 (65 Hz). A note peaks between -16 and -11 dBFS, and a harder strike is louder and brighter.\",\"lineage\":\"i_soul_bass\",\"factory\":\"soul_bass\",\"retired\":[],\"voices\":1,\"controls\":[{\"slot\":1,\"id\":\"mute\",\"label\":\"Mute\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":40,\"rand\":[15,85],\"hint\":\"The foam under the strings: darker, and the time a held note takes to fall 60 dB shortens from Decay to 250 ms\"},{\"slot\":2,\"id\":\"touch\",\"label\":\"Touch\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":30,\"rand\":[0,70],\"hint\":\"From the thumb, soft and plucked 30% along the string, to a fingertip at 12%, brighter\"},{\"slot\":3,\"id\":\"decay\",\"label\":\"Decay\",\"min\":500,\"max\":6000,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":2500,\"rand\":[1000,5000],\"hint\":\"Time for a held note to fall 60 dB with no mute\"},{\"slot\":4,\"id\":\"tone\",\"label\":\"Tone\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":45,\"rand\":[15,80],\"hint\":\"The tone control, a low-pass from 250 Hz to 4 kHz\"}],\"nodes\":[{\"id\":\"mute\",\"op\":\"param\",\"control\":\"mute\"},{\"id\":\"touch\",\"op\":\"param\",\"control\":\"touch\"},{\"id\":\"decay\",\"op\":\"param\",\"control\":\"decay\"},{\"id\":\"tone\",\"op\":\"param\",\"control\":\"tone\"},{\"id\":\"hz\",\"op\":\"note\",\"base\":36},{\"id\":\"rate_sr\",\"op\":\"sr\"},{\"id\":\"hit\",\"op\":\"trig\"},{\"id\":\"held\",\"op\":\"gate\"},{\"id\":\"vel\",\"op\":\"velocity\"},{\"id\":\"period\",\"op\":\"div\"},{\"id\":\"pick_oct\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":-0.5,\"out_hi\":2.5},{\"id\":\"vel_oct\",\"op\":\"scale\",\"out_lo\":-1,\"out_hi\":0.5},{\"id\":\"picked\",\"op\":\"add\"},{\"id\":\"pick_ratio\",\"op\":\"exp2\"},{\"id\":\"pick_hz\",\"op\":\"mul\"},{\"id\":\"tip\",\"op\":\"mul\",\"b\":0.033},{\"id\":\"flick\",\"op\":\"onepole\"},{\"id\":\"tall\",\"op\":\"mul\"},{\"id\":\"burst\",\"op\":\"slide\",\"up\":0,\"down\":0.8},{\"id\":\"noise\",\"op\":\"noise\"},{\"id\":\"centre\",\"op\":\"mono\"},{\"id\":\"grit\",\"op\":\"mul\"},{\"id\":\"grit_amt\",\"op\":\"mul\",\"b\":0},{\"id\":\"excite\",\"op\":\"add\"},{\"id\":\"corner\",\"op\":\"onepole\"},{\"id\":\"pluck_at\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":0.3,\"out_hi\":0.12},{\"id\":\"pos_t\",\"op\":\"mul\"},{\"id\":\"node_dl\",\"op\":\"delay\",\"unit\":\"samples\",\"interp\":\"linear\",\"max_ms\":25},{\"id\":\"plucked\",\"op\":\"sub\"},{\"id\":\"mute_t\",\"op\":\"mul\",\"b\":0.01},{\"id\":\"avg_t\",\"op\":\"add\",\"a\":0.35},{\"id\":\"log_dec\",\"op\":\"log\"},{\"id\":\"ring_log\",\"op\":\"mix\",\"b\":5.52146},{\"id\":\"ring_ms\",\"op\":\"exp\"},{\"id\":\"length\",\"op\":\"select\",\"
ilterAssetId":"factory:harmonic:Harmonic","cell1_tablefilterDepth":100.0,"cell1_tablefilterEnabled":0.0,"cell1_tablefilterFrame":0.0,"cell1_tablefilterMix":100.0,"cell1_tablefilterOutputGain":0.0,"cell1_tablefilterResonance":100.0,"cell1_tablefilterSmooth":15.0,"cell1_tapeDrive":60.0,"cell1_tapeEnabled":1.0,"cell1_tapeMix":100.0,"cell1_tapeMode":1.0,"cell1_tapeOutputGain":0.0,"cell1_tapeTone":0.0,"cell1_tapeWear":30.0,"cell1_tempoSync":0.0,"cell1_transientAttack":0.0,"cell1_transientEnabled":0.0,"cell1_transientHarmonic":100.0,"cell1_transientOther":100.0,"cell1_transientOutputGain":0.0,"cell1_transientPercussive":100.0,"cell1_transientSpeed":1.0,"cell1_transientSplitMode":1.0,"cell1_transientSustain":0.0,"cell1_vcaDepth":0.0,"cell1_vinylbrakeCurve":0.0,"cell1_vinylbrakeEnabled":1.0,"cell1_vinylbrakeEngage":0.0,"cell1_vinylbrakeMix":100.0,"cell1_vinylbrakeMode":0.0,"cell1_vinylbrakeOutputGain":0.0,"cell1_vinylbrakeQuantize":0.0,"cell1_vinylbrakeRise":0.4249399170492218,"cell1_vinylbrakeScratch":0.0,"cell1_vinylbrakeSlow":0.8,"cell1_vinylbrakeSyncEnabled":0.0,"cell1_vocoderEnabled":0.0,"cell1_vocoderFormant":0.0,"cell1_vocoderMix":100.0,"cell1_vocoderNote":60.0,"cell1_vocoderOutputGain":0.0,"cell1_vocoderSpeed":1.0,"cell1_vocoderWave":0.0,"cell1_vocoderWidth":100.0,"cell1_volume":-3.0,"cell1_wavefoldAmount":0.0,"cell1_wavefoldDrive":0.0,"cell1_wavefoldEnabled":0.0,"cell1_wavefoldMix":100.0,"cell1_wavefoldMotion":0.0,"cell1_wavefoldOutputGain":0.0,"cell1_wavefoldSymmetry":0.0,"cell1_wavefoldTexture":0.0,"cell2_arpeg":0.0,"cell2_arpegMode":0.0,"cell2_ccOut1":64.0,"cell2_ccOut10":64.0,"cell2_ccOut11":64.0,"cell2_ccOut12":64.0,"cell2_ccOut13":64.0,"cell2_ccOut14":64.0,"cell2_ccOut15":64.0,"cell2_ccOut16":64.0,"cell2_ccOut1Sequence":[],"cell2_ccOut2":64.0,"cell2_ccOut2Sequence":[],"cell2_ccOut3":64.0,"cell2_ccOut3Sequence":[],"cell2_ccOut4":64.0,"cell2_ccOut4Sequence":[],"cell2_ccOut5":64.0,"cell2_ccOut6":64.0,"cell2_ccOut7":64.0,"cell2_ccOut8":64.0,"cell2_ccOut9":64.0,"cell2_cellmixEnabled":0.0,"cell2_cellmixMix":50.0,"cell2_cellmixOutputGain":0.0,"cell2_cellmixPan1":0.0,"cell2_cellmixPan2":0.0,"cell2_chaos":0.0,"cell2_chorusDelay":1.08,"cell2_chorusDepth":41.5,"cell2_chorusEnabled":0.0,"cell2_chorusMix":50.0,"cell2_chorusMode":0.0,"cell2_chorusOutputGain":0.0,"cell2_chorusRate":0.36374397312811757,"cell2_chorusSpread":100.0,"cell2_chorusSyncEnabled":0.0,"cell2_chorusTone":7000.0,"cell2_cmfx":"{\"format\":\"cmfx/1\",\"kind\":\"fx\",\"name\":\"12-Bit Reverb\",\"description\":\"A 1986 hardware reverb with its 12-bit grit. A model of its DSP runs the unit's own 63 ROM programs at its 23.4 kHz, through its 12-bit converters and filters, whatever the session's rate, so it keeps the unit's grit and its 10 kHz top end. Program picks one: 1 to 50 are rooms and halls ringing 0.2 to 13 s, 51 to 59 gated, 60 to 63 reverse swells, and 64 is off. A program change fades out over 10 ms and starts the new program empty. Pre-delay holds the tail back. Drive sets the level into the converters and scales it back after, so lower adds their grit and higher clips them. Width spreads the two outputs from mono to wider than the unit made them. Drums come out within 3 dB of dry, and a limiter and a clip at -0.2 dBFS keep it under full scale.\",\"lineage\":\"f_twelve_bit_reverb\",\"factory\":\"twelve_bit_reverb\",\"retired\":[],\"mix\":0.3,\"controls\":[{\"slot\":1,\"id\":\"program\",\"label\":\"Program\",\"min\":1,\"max\":64,\"unit\":\"\",\"default\":20,\"smooth\":0,\"morph\":\"snap\",\"rand\":[1,59],\"hint\":\"Which ROM program plays: 1 to 50 rooms and halls, 0.2 to 13 s, 51 to 59 gated, 60 to 63 reverse, 64 off\"},{\"slot\":2,\"id\":\"predelay\",\"label\":\"Pre-delay\",\"min\":0,\"max\":250,\"unit\":\"ms\",\"default\":0,\"rand\":[0,60],\"hint\":\"Holds the tail back from the dry sound\"},{\"slot\":3,\"id\":\"drive\",\"label\":\"Drive\",\"min\":-18,\"max\":12,\"unit\":\"dB\",\"default\":0,\"rand\":[-9,6],\"hint\":\"Level into the converters, scaled back after: lower adds their grit, higher clips them\"},{\"slot\":4,\"id\":\"width\",\"label\":\"Width\",\"min\":0,\"max\":150,\"unit\":\"%\",\"default\":100,\"rand\":[70,140],\"hint\":\"Spreads the two outputs from mono to wider than the unit made them\"}],\"nodes\":[{\"id\":\"program\",\"op\":\"param\",\"control\":\"program\"},{\"id\":\"predelay\",\"op\":\"param\",\"control\":\"predelay\"},{\"id\":\"drive\",\"op\":\"param\",\"control\":\"drive\"},{\"id\":\"width\",\"op\":\"param\",\"control\":\"width\"},{\"id\":\"pre\",\"op\":\"delay\",\"max_ms\":250},{\"id\":\"gain\",\"op\":\"dbtoa\"},{\"id\":\"hot\",\"op\":\"mul\"},{\"id\":\"unit\",\"op\":\"romverb\"},{\"id\":\"back\",\"op\":\"div\"},{\"id\":\"spread\",\"op\":\"mul\",\"b\":0.01},{\"id\":\"image\",\"op\":\"width\"},{\"id\":\"mag\",\"op\":\"abs\"},{\"id\":\"halves\",\"op\":\"split\"},{\"id\":\"louder\",\"op\":\"max\"},{\"id\":\"env\",\"op\":\"follow\",\"attack\":0.02,\"release\":300},{\"id\":\"floor\",\"op\":\"max\",\"b\":0.89},{\"id\":\"limit\",\"op\":\"div\",\"a\":0.89},{\"id\":\"duck\",\"op\":\"mul\"},{\"id\":\"ceiling\",\"op\":\"clamp\",\"lo\":-0.98,\"hi\":0.98}],\"cables\":[[\"in\",\"pre\"],[\"predelay\",\"pre.time\"],[\"drive\",\"gain\"],[\"pre\",\"hot\"],[\"gain\",\"hot.b\"],[\"hot\",\"unit\"],[\"program\",\"unit.program\"],[\"unit\",\"back\"],[\"gain\",\"back.b\"],[\"width\",\"spread\"],[\"back\",\"image\"],[\"spread\",\"image.width\"],[\"image\",\"mag\"],[\"mag\",\"halves\"],[\"halves.l\",\"louder\"],[\"halves.r\",\"louder.b\"],[\"louder\",\"env\"],[\"env\",\"floor\"],[\"floor\",\"limit.b\"],[\"image\",\"duck\"],[\"limit\",\"duck.b\"],[\"duck\",\"ceiling\"],[\"ceiling\",\"out\"]],\"ui\":{\"sections\":[{\"label\":\"ROM\",\"widgets\":[{\"type\":\"knob\",\"control\":\"program\",\"size\":\"l\"}]},{\"label\":\"Input\",\"widgets\":[{\"type\":\"knob\",\"control\":\"predelay\"},{\"type\":\"knob\",\"control\":\"drive\"}]},{\"label\":\"Space\",\"widgets\":[{\"type\":\"knob\",\"control\":\"width\"}]}]}}","cell2_cmfxEnabled":1.0,"cell2_cmfxLayout":"","cell2_cmfxMix":16.0,"cell2_cmfxOutputGain":0.0,"cell2_cmfx_p1":0.1746031746031746,"cell2_cmfx_p10":0.5,"cell2_cmfx_p11":0.5,"cell2_cmfx_p12":0.5,"cell2_cmfx_p13":0.5,"cell2_cmfx_p14":0.5,"cell2_cmfx_p15":0.5,"cell2_cmfx_p16":0.5,"cell2_cmfx_p17":0.5,"cell2_cmfx_p18":0.5,"cell2_cmfx_p19":0.5,"cell2_cmfx_p2":0.024,"cell2_cmfx_p20":0.5,"cell2_cmfx_p21":0.5,"cell2_cmfx_p22":0.5,"cell2_cmfx_p23":0.5,"cell2_cmfx_p24":0.5,"cell2_cmfx_p3":0.7333333333333333,"cell2_cmfx_p4":0.7333333333333333,"cell2_cmfx_p5":0.5,"cell2_cmfx_p6":0.5,"cell2_cmfx_p7":0.5,"cell2_cmfx_p8":0.5,"cell2_cmfx_p9":0.5,"cell2_cmi":"{\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"name\":\"Snare\",\"description\":\"An analog-style snare. Two sines for the drum head, at Pitch and 1.6 times it, start a little sharp, settle within 20 ms and fall 60 dB over Ring. Over them is a burst of noise, high-passed at Tone and as loud as Snappy sets, which falls 60 dB over Decay. Velocity sets the level, and a new strike cuts off the one still ringing. On a poly cell the played notes transpose it: the cell's poly root (48 by default) sounds at Pitch.\",\"lineage\":\"i_snare\",\"factory\":\"snare\",\"retired\":[],\"voices\":1,\"controls\":[{\"slot\":1,\"id\":\"tune\",\"label\":\"Pitch\",\"min\":100,\"max\":400,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":185,\"rand\":[140,280],\"hint\":\"Pitch of the lower drum-head sine, with the other at 1.6 times it\"},{\"slot\":2,\"id\":\"body\",\"label\":\"Ring\",\"min\":30,\"max\":800,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":160,\"rand\":[60,400],\"hint\":\"Time for the drum-head sines to fall 60 dB\"},{\"slot\":3,\"id\":\"snappy\",\"label\":\"Snappy\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":60,\"rand\":[25,90],\"hint\":\"Level of the noise burst over the head, which itself drops to 55% of its level as Snappy rises to 100\"},{\"slot\":4,\"id\":\"decay\",\"label\":\"Decay\",\"min\":40,\"max\":1500,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":260,\"rand\":[100,700],\"hint\":\"Time for the noise burst to fall 60 dB\"},{\"slot\":5,\"id\":\"tone\",\"label\":\"Tone\",\"min\":800,\"max\":9000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":2500,\"rand\":[1200,6000],\"hint\":\"Frequency the noise is high-passed at, with a low-pass at three times it: higher is thinner\"}],\"nodes\":[{\"id\":\"tune\",\"op\":\"param\",\"control\":\"tune\"},{\"id\":\"body\",\"op\":\"param\",\"control\":\"body\"},{\"id\":\"snappy\",\"op\":\"param\",\"control\":\"snappy\"},{\"id\":\"decay\",\"op\":\"param\",\"control\":\"decay\"},{\"id\":\"tone\",\"op\":\"param\",\"control\":\"tone\"},{\"id\":\"hit\",\"op\":\"trig\"},{\"id\":\"strike\",\"op\":\"gt\"},{\"id\":\"hz\",\"op\":\"note\",\"base\":60},{\"id\":\"root\",\"op\":\"mtof\",\"in\":60},{\"id\":\"ratio\",\"op\":\"div\"},{\"id\":\"f1\",\"op\":\"mul\"},{\"id\":\"sharp\",\"op\":\"slide\",\"up\":0,\"down\":6},{\"id\":\"bend\",\"op\":\"scale\",\"out_lo\":1,\"out_hi\":1.25},{\"id\":\"f1b\",\"op\":\"mul\"},{\"id\":\"f2b\",\"op\":\"mul\",\"b\":1.6},{\"id\":\"ph1\",\"op\":\"phasor\"},{\"id\":\"ph2\",\"op\":\"phasor\"},{\"id\":\"s1\",\"op\":\"cycle\",\"freq\":0},{\"id\":\"s2\",\"op\":\"cycle\",\"freq\":0},{\"id\":\"s2_lvl\",\"op\":\"mul\",\"b\":0.5},{\"id\":\"head\",\"op\":\"add\"},{\"id\":\"btau\",\"op\":\"div\",\"b\":6.9078},{\"id\":\"bring\",\"op\":\"slide\",\"up\":0},{\"id\":\"head_lvl\",\"op\":\"scale\",\"in_lo\":0,\"in_hi\":100,\"out_lo\":1,\"out_hi\":0.55},{\"id\":\"head_env\",\"op\":\"mul\"},{\"id\":\"head_out\",\"op\":\"mul\"},{\"id\":\"noise\",\"op\":\"noise\"},{\"id\":\"hiss\",\"op\":\"mono\"},{\"id\":\"n_hz\",\"op\":\"mul\"},{\"id\":\"hp\",\"op\":\"svf\",\"mode\":\"hp\",\"q\":0.7},{\"id\":\"n_top\",\"op\":\"mul\",\"b\":3},{\"id\":\"lp\",\"op\":\"onepole\"},{\"id\":\"ntau\",\"op\":\"div\",\"b\":6.9078},{\"id\":\"nring\",\"op\":\"slide\",\"up\":0},{\"id\":\"snap_amt\",\"op\":\"mul\",\"b\":0.012},{\"id\":\"snap_env\",\"op\":\"mul\"},{\"id\":\"snap_out\",\"op\":\"mul\"},{\"id\":\
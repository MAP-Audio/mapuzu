Mix":50.0,"cell7_chorusMode":0.0,"cell7_chorusOutputGain":0.0,"cell7_chorusRate":0.36374397312811757,"cell7_chorusSpread":100.0,"cell7_chorusSyncEnabled":0.0,"cell7_chorusTone":7000.0,"cell7_cmfx":"{\"format\":\"cmfx/1\",\"kind\":\"fx\",\"name\":\"Grain Haze\",\"description\":\"A wash of overlapping grains. Four streams of Size-long grains, a quarter of a grain apart, each read the last Scatter ms of the input from a point drawn anew for every grain, and two allpasses smear the result. Cloud plays every grain at normal speed. Up plays the second pair of streams at double speed, an octave up, and Down at half speed, an octave down. Stretch draws no positions but walks them back at half speed, so the input plays at half its pace and its own pitch. Density brings in the second pair of streams and widens the reach from 30% of Scatter to all of it. Feedback sends the wash back to be scattered again with the input turned down to match, and Width lets each side draw its own positions. The streams of a pair always sum to full level, so drums come out within 3 dB of the dry level. The input passes a DC blocker first, so Feedback does not build up an offset that the input carries.\",\"lineage\":\"f_grain_haze\",\"factory\":\"grain_haze\",\"retired\":[],\"mix\":0.6,\"controls\":[{\"slot\":1,\"id\":\"density\",\"label\":\"Density\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":60,\"rand\":[20,100],\"hint\":\"Level of the second pair of grain streams, and how much of Scatter the grains reach back\"},{\"slot\":2,\"id\":\"mode\",\"label\":\"Mode\",\"values\":[0,1,2,3],\"labels\":[\"Stretch\",\"Cloud\",\"Up\",\"Down\"],\"unit\":\"\",\"default\":1,\"smooth\":0,\"morph\":\"snap\",\"rand\":[0,3],\"hint\":\"Half-pace stretch at pitch, a cloud at normal speed, or a second pair of streams an octave up or down\"},{\"slot\":3,\"id\":\"size\",\"label\":\"Size\",\"min\":20,\"max\":300,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":120,\"rand\":[50,250],\"hint\":\"Length of each grain\"},{\"slot\":4,\"id\":\"scatter\",\"label\":\"Scatter\",\"min\":10,\"max\":500,\"unit\":\"ms\",\"default\":250,\"rand\":[60,450],\"hint\":\"How far back in the input a grain may start\"},{\"slot\":5,\"id\":\"feedback\",\"label\":\"Feedback\",\"min\":0,\"max\":70,\"unit\":\"%\",\"default\":30,\"rand\":[0,60],\"hint\":\"How much of the wash is scattered again\"},{\"slot\":6,\"id\":\"width\",\"label\":\"Width\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":70,\"rand\":[20,100],\"hint\":\"Lets each side draw its own grain positions\"}],\"nodes\":[{\"id\":\"density\",\"op\":\"param\",\"control\":\"density\"},{\"id\":\"mode\",\"op\":\"param\",\"control\":\"mode\"},{\"id\":\"size\",\"op\":\"param\",\"control\":\"size\"},{\"id\":\"scatter\",\"op\":\"param\",\"control\":\"scatter\"},{\"id\":\"feedback\",\"op\":\"param\",\"control\":\"feedback\"},{\"id\":\"width\",\"op\":\"param\",\"control\":\"width\"},{\"id\":\"is_0\",\"op\":\"eq\",\"b\":0},{\"id\":\"is_2\",\"op\":\"eq\",\"b\":2},{\"id\":\"is_3\",\"op\":\"eq\",\"b\":3},{\"id\":\"d\",\"op\":\"mul\",\"b\":0.01},{\"id\":\"reach_part\",\"op\":\"scale\",\"out_lo\":0.3,\"out_hi\":1},{\"id\":\"reach\",\"op\":\"mul\"},{\"id\":\"grain_hz\",\"op\":\"div\",\"a\":1000},{\"id\":\"turn\",\"op\":\"phasor\"},{\"id\":\"noise\",\"op\":\"noise\"},{\"id\":\"centre\",\"op\":\"mono\"},{\"id\":\"w\",\"op\":\"mul\",\"b\":0.01},{\"id\":\"drawn\",\"op\":\"mix\"},{\"id\":\"unit\",\"op\":\"scale\",\"in_lo\":-1,\"in_hi\":1,\"out_lo\":0,\"out_hi\":1},{\"id\":\"walk_hz\",\"op\":\"div\",\"a\":500},{\"id\":\"walk\",\"op\":\"phasor\"},{\"id\":\"place\",\"op\":\"select\"},{\"id\":\"speed_2\",\"op\":\"mul\",\"b\":1},{\"id\":\"speed_3\",\"op\":\"mul\",\"b\":-0.5},{\"id\":\"speed\",\"op\":\"add\",\"b\":1},{\"id\":\"over\",\"op\":\"sub\",\"b\":1},{\"id\":\"lead\",\"op\":\"max\",\"b\":0},{\"id\":\"slope\",\"op\":\"sub\",\"a\":1},{\"id\":\"g\",\"op\":\"mul\",\"b\":0.01},{\"id\":\"g_sq\",\"op\":\"mul\"},{\"id\":\"room\",\"op\":\"sub\",\"a\":1},{\"id\":\"drive\",\"op\
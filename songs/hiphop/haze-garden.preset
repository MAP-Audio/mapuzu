514{"appVersion":"1.8.6","author":"mapuzu","bpm":86.0,"category":"Drums","createdAt":1794875386013.0,"description":"Hip hop kit for haze-garden.strudel.js: eight CMI instruments with CM-FX, master Tape, and three variations that PAM morphs between over two bars. Strudel plays every note but the tabla, which PAM plays from a pattern of its own.","factory":false,"modifiedAt":1794877659443.0,"name":"Haze Garden","product":"pam","subcategory":"Hip Hop","variationSlots":[true,true,true,false,false,false,false,false]}{"appVersion":"1.8.6","cell1_arpeg":0.0,"cell1_arpegMode":0.0,"cell1_ccOut1":64.0,"cell1_ccOut10":64.0,"cell1_ccOut11":64.0,"cell1_ccOut12":64.0,"cell1_ccOut13":64.0,"cell1_ccOut14":64.0,"cell1_ccOut15":64.0,"cell1_ccOut16":64.0,"cell1_ccOut1Sequence":[],"cell1_ccOut2":64.0,"cell1_ccOut2Sequence":[],"cell1_ccOut3":64.0,"cell1_ccOut3Sequence":[],"cell1_ccOut4":64.0,"cell1_ccOut4Sequence":[],"cell1_ccOut5":64.0,"cell1_ccOut6":64.0,"cell1_ccOut7":64.0,"cell1_ccOut8":64.0,"cell1_ccOut9":64.0,"cell1_cellmixEnabled":0.0,"cell1_cellmixMix":50.0,"cell1_cellmixOutputGain":0.0,"cell1_cellmixPan1":0.0,"cell1_cellmixPan2":0.0,"cell1_chaos":0.0,"cell1_chorusDelay":1.08,"cell1_chorusDepth":41.5,"cell1_chorusEnabled":0.0,"cell1_chorusMix":50.0,"cell1_chorusMode":0.0,"cell1_chorusOutputGain":0.0,"cell1_chorusRate":0.36374397312811757,"cell1_chorusSpread":100.0,"cell1_chorusSyncEnabled":0.0,"cell1_chorusTone":7000.0,"cell1_cmfx":"","cell1_cmfxEnabled":0.0,"cell1_cmfxLayout":"","cell1_cmfxMix":100.0,"cell1_cmfxOutputGain":0.0,"cell1_cmfx_p1":0.5,"cell1_cmfx_p10":0.5,"cell1_cmfx_p11":0.5,"cell1_cmfx_p12":0.5,"cell1_cmfx_p13":0.5,"cell1_cmfx_p14":0.5,"cell1_cmfx_p15":0.5,"cell1_cmfx_p16":0.5,"cell1_cmfx_p17":0.5,"cell1_cmfx_p18":0.5,"cell1_cmfx_p19":0.5,"cell1_cmfx_p2":0.5,"cell1_cmfx_p20":0.5,"cell1_cmfx_p21":0.5,"cell1_cmfx_p22":0.5,"cell1_cmfx_p23":0.5,"cell1_cmfx_p24":0.5,"cell1_cmfx_p3":0.5,"cell1_cmfx_p4":0.5,"cell1_cmfx_p5":0.5,"cell1_cmfx_p6":0.5,"cell1_cmfx_p7":0.5,"cell1_cmfx_p8":0.5,"cell1_cmfx_p9":0.5,"cell1_cmi":"{\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"name\":\"Fold Drum\",\"description\":\"A tuned drum for kicks, also good for toms, percussion and clicks. Each strike restarts a sine from zero, rising, Sweep semitones above Pitch. With Shape at Exp the pitch falls 95% of the way to Pitch within Fall. Knee holds it near the top first and then drops faster. Click bends the sine's own phase with a burst at Tone that fades over about two cycles of that frequency, within 0.3 to 5 ms, so the click is part of the waveform itself. Drive is how many dB a full-velocity hit goes past the shaper's threshold. Past it, Mode Fold folds the wave back and Clip rounds it off. With Low Cut off, the peak level stays within 1.5 dB across Drive's range, and more drive holds up the decay. Bloom lowers the drive by that many dB at the strike and brings it back as the pitch falls, so the hit starts softer and darker. Decay is the time the level takes to fall 60 dB. With Body at Pillow it starts to fall at the strike, and Punch first holds full level for one cycle of the pitch, 25 ms at most. Low Cut is a 12 dB per octave high-pass. It is off at its lowest setting of 10 Hz and fades in fully by 20 Hz, and Track moves it with the played note. Gap and Span cut out a band of frequencies that starts at Gap and is Span octaves wide. At its centre the cut is about 14 dB for a 1-octave band, 25 dB for 2 octaves and 36 dB for 3. Span 0 leaves the sound unchanged. A fast limiter at the output pulls back any peak over -4 dBFS, which Low Cut and Gap can add to a clipped wave. Velocity sets how hard the drum is hit. A hit at velocity 0 loses Dyna Drive dB of drive, and the share of Decay, Sweep and Click that Dyna Decay, Dyna Sweep and Dyna Click set. A harder hit loses less. At velocity 100 it peaks near -7 dBFS, and at velocity 30 about 6 dB lower. It plays one voice, so a new strike cuts the ringing one and restarts the sine, fading the old ring's last sample out over a few ms instead of stepping to zero. On a poly cell the played notes transpose it around Pitch: the cell's poly root (48 by default) sounds at Pitch.\",\"lineage\":\"i_fold_drum\",\"factory\":\"fold_drum\",\"retired\":[],\"voices\":1,\"controls\":[{\"slot\":1,\"id\":\"pitch\",\"label\":\"Pitch\",\"min\":20,\"max\":2000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":50,\"rand\":[38,90],\"hint\":\"Pitch the drum settles on: on a poly cell the cell's poly root sounds at it, and other keys transpose it\"},{\"slot\":2,\"id\":\"sweep\",\"label\":\"Sweep\",\"min\":0,\"max\":60,\"unit\":\"st\",\"default\":30,\"rand\":[12,42],\"hint\":\"How many semitones above Pitch each strike starts\"},{\"slot\":3,\"id\":\"decay\",\"label\":\"Decay\",\"min\":20,\"max\":4000,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":500,\"rand\":[150,1500],\"hint\":\"Time for the level to fall 60 dB, counted after Punch's hold\"},{\"slot\":4,\"id\":\"drive\",\"label\":\"Drive\",\"min\":0,\"max\":30,\"unit\":\"dB\",\"default\":3,\"rand\":[0,18],\"hint\":\"How many dB a full-velocity hit goes past the shaper's threshold: the peak level stays within 1.5 dB as the sound gets brighter\"},{\"slot\":5,\"id\":\"click\",\"label\":\"Click\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":40,\"rand\":[0,80],\"hint\":\"Depth of the burst that bends the phase at the start of the waveform\"},{\"slot\":6,\"id\":\"sweep_time\",\"label\":\"Fall\",\"min\":5,\"max\":500,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":45,\"rand\":[15,150],\"hint\":\"Time for the Exp sweep to fall 95% of the way to Pitch. Knee holds near the top first\"},{\"slot\":7,\"id\":\"click_tone\",\"label\":\"Tone\",\"min\":200,\"max\":8000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":1500,\"rand\":[500,5000],\"hint\":\"Frequency of the click's burst: low for a knock, high for a tick\"},{\"slot\":8,\"id\":\"bloom\",\"label\":\"Bloom\",\"min\":0,\"max\":24,\"unit\":\"dB\",\"default\":0,\"rand\":[0,12],\"hint\":\"How many dB lower the drive starts at the strike, coming back as the sweep falls\"},{\"slot\":9,\"id\":\"shape\",\"label\":\"Shape\",\"values\":[0,1],\"labels\":[\"Knee\",\"Exp\"],\"default\":0,\"unit\":\"\",\"morph\":\"snap\",\"hint\":\"How the pitch falls: Knee holds near the top and then drops, Exp drops at once\"},{\"slot\":10,\"id\":\"mode\",\"label\":\"Mode\",\"values\":[0,1],\"labels\":[\"Fold\",\"Clip\"],\"default\":0,\"unit\":\"\",\"morph\":\"snap\",\"hint\":\"What happens past the threshold: Fold folds the wave back, Clip rounds it off\"},{\"slot\":11,\"id\":\"body\",\"label\":\"Body\",\"values\":[0,1],\"labels\":[\"Pillow\",\"Punch\"],\"default\":1,\"unit\":\"\",\"morph\":\"snap\",\"hint\":\"Pillow starts to fall at the strike, Punch first holds full level for one cycle of the pitch\"},{\"slot\":12,\"id\":\"low_cut\",\"label\":\"Low Cut\",\"min\":10,\"max\":1000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":10,\"rand\":[10,40],\"hint\":\"Cutoff of a 12 dB per octave high-pass after the shaper: off at 10 Hz, fully in from 20 Hz\"},{\"slot\":13,\"id\":\"track\",\"label\":\"Track\",\"values\":[0,1],\"labels\":[\"Off\",\"On\"],\"default\":0,\"unit\":\"\",\"morph\":\"snap\",\"hint\":\"On: the Low Cut frequency moves with the played note\"},{\"slot\":14,\"id\":\"gap\",\"label\":\"Gap\",\"min\":60,\"max\":4000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":400,\"rand\":[150,2000],\"hint\":\"Where the cut band starts\"},{\"slot\":15,\"id\":\"span\",\"label\":\"Span\",\"min\":0,\"max\":6,\"unit\":\"oct\",\"default\":0,\"rand\":[0,3],\"hint\":\"Width of the cut band in octaves: 0 leaves the sound unchanged, 3 cuts about 36 dB at its centre\"},{\"slot\":16,\"id\":\"dyna_drive\",\"label\":\"Dyna Drive\",\"min\":0,\"max\":36,\"unit\":\"dB\",\"default\":12,\"rand\":[0,24],\"hint\":\"How many dB of drive a hit at velocity 0 loses, less for harder hits\"},{\"slot\":17,\"id\":\"dyna_decay\",\"label\":\"Dyna Decay\",\"min\":0,\"max\":90,\"unit\":\"%\",\"default\":30,\"rand\":[0,60],\"hint\":\"Share of Decay a hit at velocity 0 loses, less for harder hits\"},{\"slot\":18,\"id\":\"dyna_sweep\",\"label\":\"Dyna Sweep\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":30,\"rand\":[0,70],\"hint\":\"Share of Sweep a hit at velocity 0 loses, less for harder hits\"},{\"slot\":19,\"id\":\"dyna_click\",\"label\":\"Dyna Click\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":50,\"rand\":[0,100],\"hint\":\"Share of Click a hit at velocity 0 loses, less for harder hits\"}],\"nodes\":[{\"id\":\"pitch\",\"op\":\"param\",\"control\":\"pitch\"},{\"id\":\"sweep\",\"op\":\"param\",\"control\":\"sweep\"},{\"id\":\"decay\",\"op\":\"param\",\"control\":\"decay\"},{\"id\":\"drive\",\"op\":\"param\",\"control\":\"drive\"},{\"id\":\"click\",\"op\":\"param\",\"control\":\"click\"},{\"id\":\"sweep_time\",\"op\":\"param\",\"control\":\"sweep_time\"},{\"id\":\"click_tone\",\"op\":\"param\",\"control\":\"click_tone\"},{\"id\":\"bloom\",\"op\":\"param\",\"control\":\"bloom\"},{\"id\":\"shape\",\"op\":\"param\",\"control\":\"shape\"},{\"id\":\"mode\",\"op\":\"param\",\"control\":\"mode\"},{\"id\":\"body\",\"op\":\"param\",\"control\":\"body\"},{\"id\":\"low_cut\",\"op\":\"param\",\"control\":\"low_cut\"},{\"id\":\"track\",\"op\":\"param\",\"control\":\"track\"},{\"id\":\"gap\",\"op\":\"param\",\"control\":\"gap\"},{\"id\":\"span\",\"op\":\"param\",\"control\":\"span\"},{\"id\":\"dyna_drive\",\"op\":\"param\",\"control\":\"dyna_drive\"},{\"id\":\"dyna_decay\",\"op\":\"param\",\"control\":\"dyna_decay\"},{\"id\":\"dyna_sweep\",\"op\":\"param\",\"control\":\"dyna_sweep\"},{\"id\":\"dyna_click\",\"op\":\"param\",\"control\":\"dyna_click\"},{\"id\":\"hit\",\"op\":\"trig\"},{\"id\":\"strike\",\"op\":\"gt\"},{\"id\":\"vel\",\"op\":\"velocity\"},{\"id\":\"soft\",\"op\":\"sub\",\"a\":1},{\"id\":\"hz\",\"op\":\"note\",\"base\":60},{\"id\":\"root\",\"op\":\"mtof\",\"in\":60},{\"id\":\"ratio\",\"op\":\"div\"},{\"id\":\"base_hz\",\"op\":\"mul\"},{\"id\":\"sw_tau\",\"op\":\"mul\",\"b\":0.33333333333
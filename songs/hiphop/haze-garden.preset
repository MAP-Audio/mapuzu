\"ceiling\",\"out\"]],\"ui\":{\"sections\":[{\"label\":\"Grains\",\"widgets\":[{\"type\":\"knob\",\"control\":\"density\",\"size\":\"l\"},{\"type\":\"choice\",\"control\":\"mode\"},{\"type\":\"knob\",\"control\":\"size\"},{\"type\":\"knob\",\"control\":\"scatter\"}]},{\"label\":\"Wash\",\"widgets\":[{\"type\":\"knob\",\"control\":\"feedback\"},{\"type\":\"knob\",\"control\":\"width\"}]}]}}","cell7_cmfxEnabled":1.0,"cell7_cmfxLayout":"","cell7_cmfxMix":35.0,"cell7_cmfxOutputGain":0.0,"cell7_cmfx_p1":0.55,"cell7_cmfx_p10":0.5,"cell7_cmfx_p11":0.5,"cell7_cmfx_p12":0.5,"cell7_cmfx_p13":0.5,"cell7_cmfx_p14":0.5,"cell7_cmfx_p15":0.5,"cell7_cmfx_p16":0.5,"cell7_cmfx_p17":0.5,"cell7_cmfx_p18":0.5,"cell7_cmfx_p19":0.5,"cell7_cmfx_p2":0.375,"cell7_cmfx_p20":0.5,"cell7_cmfx_p21":0.5,"cell7_cmfx_p22":0.5,"cell7_cmfx_p23":0.5,"cell7_cmfx_p24":0.5,"cell7_cmfx_p3":0.7185650207899779,"cell7_cmfx_p4":0.5918367346938775,"cell7_cmfx_p5":0.42857142857142855,"cell7_cmfx_p6":0.9,"cell7_cmfx_p7":0.5,"cell7_cmfx_p8":0.5,"cell7_cmfx_p9":0.5,"cell7_cmi":"{\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"name\":\"Tape Pad\",\"description\":\"A pad off a worn tape, one strip per note as a tape keyboard has. A triangle at the note and a saw, 3 cents below it on the left and above it on the right, are pushed Drive dB into the tape's saturation, which thickens them without making them louder, and then pass through a gentle high-cut at Tone. Each note's pitch drifts up to Wow cents either way about every two seconds and shakes up to Flutter cents at about 7 Hz, each voice at its own pace, so a chord wavers out of step. Hiss adds the tape's noise under the note, a different noise on each side. Each note swells over Attack, holds while the key is down and falls 60 dB over Release once let go. A held note sits near -25 dBFS RMS, and a harder strike plays a little louder.\",\"lineage\":\"i_tape_pad\",\"factory\":\"tape_pad\",\"retired\":[],\"voices\":8,\"controls\":[{\"slot\":1,\"id\":\"wow\",\"label\":\"Wow\",\"min\":0,\"max\":40,\"curve\":\"pow\",\"unit\":\"ct\",\"default\":12,\"rand\":[4,25],\"hint\":\"How far each note's pitch drifts either way, about once every two seconds\"},{\"slot\":2,\"id\":\"flutter\",\"label\":\"Flutter\",\"min\":0,\"max\":15,\"curve\":\"pow\",\"unit\":\"ct\",\"default\":3,\"rand\":[0,8],\"hint\":\"How far each note's pitch shakes either way at about 7 Hz\"},{\"slot\":3,\"id\":\"tone\",\"label\":\"Tone\",\"min\":300,\"max\":8000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":1800,\"rand\":[700,4500],\"hint\":\"Cutoff of the tape's high-cut, dark to bright\"},{\"slot\":4,\"id\":\"drive\",\"label\":\"Drive\",\"min\":0,\"max\":24,\"unit\":\"dB\",\"default\":4,\"rand\":[0,12],\"hint\":\"How hard the note is pushed into the tape's saturation, which thickens the tone at the same loudness\"},{\"slot\":5,\"id\":\"hiss\",\"label\":\"Hiss\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":20,\"rand\":[0,50],\"hint\":\"Level of the tape's noise under the note\"},{\"slot\":6,\"id\":\"attack\",\"label\":\"Attack\",\"min\":5,\"max\":5000,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":350,\"rand\":[100,2000],\"hint\":\"Time for a note to swell to full level\"},{\"slot\":7,\"id\":\"release\",\"label\":\"Release\",\"min\":50,\"max\":8000,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":1600,\"rand\":[500,5000],\"hint\":\"Time for a note to fall 60 dB once it is let go\"}],\"nodes\":[{\"id\":\"wow\",\"op\":\"param\",\"control\":\"wow\"},{\"id\":\"flutter\",\"op\":\"param\",\"control\":\"flutter\"},{\"id\":\"tone\",\"op\":\"param\",\"control\":\"tone\"},{\"id\":\"drive\",\"op\":\"param\",\"control\":\"drive\"},{\"id\":\"hiss\",\"op\":\"param\",\"control\":\"hiss\"},{\"id\":\"attack\",\"op\":\"param\",\"control\":\"attack\"},{\"id\":\"release\",\"op\":\"param\",\"control\":\"release\"},{\"id\":\"hz\",\"op\":\"note\",\"base\":48},{\"id\":\"index_v\",\"op\":\"voice\"},{\"id\":\"start\",\"op\":\"mul\",\"b\":0.37},{\"id\":\"wow_hz\",\"op\":\"scale\",\"out_lo\":0.4
,"cell5_ccOut6":64.0,"cell5_ccOut7":64.0,"cell5_ccOut8":64.0,"cell5_ccOut9":64.0,"cell5_cellmixEnabled":0.0,"cell5_cellmixMix":50.0,"cell5_cellmixOutputGain":0.0,"cell5_cellmixPan1":0.0,"cell5_cellmixPan2":0.0,"cell5_chaos":0.0,"cell5_chorusDelay":1.08,"cell5_chorusDepth":41.5,"cell5_chorusEnabled":0.0,"cell5_chorusMix":50.0,"cell5_chorusMode":0.0,"cell5_chorusOutputGain":0.0,"cell5_chorusRate":0.36374397312811757,"cell5_chorusSpread":100.0,"cell5_chorusSyncEnabled":0.0,"cell5_chorusTone":7000.0,"cell5_cmfx":"{\"format\":\"cmfx/1\",\"kind\":\"fx\",\"name\":\"Motown EQ\",\"description\":\"A seven-band passive graphic EQ of the 1960s soul studios. Its bands sit at 50, 130, 320, 800, 2000, 5000 and 12500 Hz, each stepping in whole dB from -8 to +8 and wider at small steps, as on the hardware. A sine at a band's centre moves by exactly its step. Each band has its own network, so neighbouring bands boosted together add more than on the hardware. With every band at 0 the input passes bit for bit.\",\"lineage\":\"f_motown_eq\",\"factory\":\"motown_eq\",\"retired\":[],\"mix\":1,\"controls\":[{\"slot\":1,\"id\":\"b50\",\"label\":\"50 Hz\",\"min\":-8,\"max\":8,\"unit\":\"dB\",\"default\":0,\"rand\":[-4,4],\"hint\":\"Boost or cut around 50 Hz in whole dB, with a wider band at small steps\"},{\"slot\":2,\"id\":\"b130\",\"label\":\"130 Hz\",\"min\":-8,\"max\":8,\"unit\":\"dB\",\"default\":2,\"rand\":[-4,4],\"hint\":\"Boost or cut around 130 Hz in whole dB, with a wider band at small steps\"},{\"slot\":3,\"id\":\"b320\",\"label\":\"320 Hz\",\"min\":-8,\"max\":8,\"unit\":\"dB\",\"default\":0,\"rand\":[-4,4],\"hint\":\"Boost or cut around 320 Hz in whole dB, with a wider band at small steps\"},{\"slot\":4,\"id\":\"b800\",\"label\":\"800 Hz\",\"min\":-8,\"max\":8,\"unit\":\"dB\",\"default\":0,\"rand\":[-4,4],\"hint\":\"Boost or cut around 800 Hz in whole dB, with a wider band at small steps\"},{\"slot\":5,\"id\":\"b2k\",\"label\":\"2 kHz\",\"min\":-8,\"max\":8,\"unit\":\"dB\",\"defa
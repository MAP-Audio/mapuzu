,"cell2_wavefoldEnabled":0.0,"cell2_wavefoldMix":100.0,"cell2_wavefoldMotion":0.0,"cell2_wavefoldOutputGain":0.0,"cell2_wavefoldSymmetry":0.0,"cell2_wavefoldTexture":0.0,"cell3_arpeg":0.0,"cell3_arpegMode":0.0,"cell3_ccOut1":64.0,"cell3_ccOut10":64.0,"cell3_ccOut11":64.0,"cell3_ccOut12":64.0,"cell3_ccOut13":64.0,"cell3_ccOut14":64.0,"cell3_ccOut15":64.0,"cell3_ccOut16":64.0,"cell3_ccOut1Sequence":[],"cell3_ccOut2":64.0,"cell3_ccOut2Sequence":[],"cell3_ccOut3":64.0,"cell3_ccOut3Sequence":[],"cell3_ccOut4":64.0,"cell3_ccOut4Sequence":[],"cell3_ccOut5":64.0,"cell3_ccOut6":64.0,"cell3_ccOut7":64.0,"cell3_ccOut8":64.0,"cell3_ccOut9":64.0,"cell3_cellmixEnabled":0.0,"cell3_cellmixMix":50.0,"cell3_cellmixOutputGain":0.0,"cell3_cellmixPan1":0.0,"cell3_cellmixPan2":0.0,"cell3_chaos":0.0,"cell3_chorusDelay":1.08,"cell3_chorusDepth":41.5,"cell3_chorusEnabled":0.0,"cell3_chorusMix":50.0,"cell3_chorusMode":0.0,"cell3_chorusOutputGain":0.0,"cell3_chorusRate":0.36374397312811757,"cell3_chorusSpread":100.0,"cell3_chorusSyncEnabled":0.0,"cell3_chorusTone":7000.0,"cell3_cmfx":"","cell3_cmfxEnabled":0.0,"cell3_cmfxLayout":"","cell3_cmfxMix":100.0,"cell3_cmfxOutputGain":0.0,"cell3_cmfx_p1":0.5,"cell3_cmfx_p10":0.5,"cell3_cmfx_p11":0.5,"cell3_cmfx_p12":0.5,"cell3_cmfx_p13":0.5,"cell3_cmfx_p14":0.5,"cell3_cmfx_p15":0.5,"cell3_cmfx_p16":0.5,"cell3_cmfx_p17":0.5,"cell3_cmfx_p18":0.5,"cell3_cmfx_p19":0.5,"cell3_cmfx_p2":0.5,"cell3_cmfx_p20":0.5,"cell3_cmfx_p21":0.5,"cell3_cmfx_p22":0.5,"cell3_cmfx_p23":0.5,"cell3_cmfx_p24":0.5,"cell3_cmfx_p3":0.5,"cell3_cmfx_p4":0.5,"cell3_cmfx_p5":0.5,"cell3_cmfx_p6":0.5,"cell3_cmfx_p7":0.5,"cell3_cmfx_p8":0.5,"cell3_cmfx_p9":0.5,"cell3_cmi":"{\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"name\":\"Hi-Hat\",\"description\":\"A metallic hi-hat: six square waves at clashing ratios above Pitch, mixed with noise as Metal sets, through a high-pass at Tone. It falls 60 dB over Decay: short for a closed hat, long for an open one. Velocity sets the level. A new strike chokes the one still ringing, so an open hat closes when the next hit lands. While the song plays, Vary rolls a die on each step of the cell's clock and stretches or shortens that hit's decay by up to a factor of two either way. Accent drops every hit off the beat by up to 60%, so the hits on the beat stand out. On a poly cell the played notes transpose it: the cell's poly root (48 by default) sounds at Pitch.\",\"lineage\":\"i_hi_hat\",\"factory\":\"hi_hat\",\"retired\":[],\"voices\":1,\"controls\":[{\"slot\":1,\"id\":\"decay\",\"label\":\"Decay\",\"min\":15,\"max\":2000,\"curve\":\"exp\",\"unit\":\"ms\",\"default\":90,\"rand\":[40,900],\"hint\":\"Time for the hat to fall 60 dB: short for a closed hat, long for an open one\"},{\"slot\":2,\"id\":\"tone\",\"label\":\"Tone\",\"min\":2000,\"max\":14000,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":7000,\"rand\":[4500,11000],\"hint\":\"Brightness of the hat: the cutoff of its high-pass, lower is darker\"},{\"slot\":3,\"id\":\"metal\",\"label\":\"Metal\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":65,\"rand\":[30,100],\"hint\":\"Balance from noise to six clashing square waves: 0% is plain noise, 100% is all squares\"},{\"slot\":4,\"id\":\"pitch\",\"label\":\"Pitch\",\"min\":100,\"max\":600,\"curve\":\"exp\",\"unit\":\"Hz\",\"default\":205,\"rand\":[150,400],\"hint\":\"Pitch of the lowest of six clashing square waves. A poly cell's played notes transpose it\"},{\"slot\":5,\"id\":\"vary\",\"label\":\"Vary\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":30,\"rand\":[0,70],\"hint\":\"While the song plays, rolls a die on each step to stretch or shorten that hit's decay by up to a factor of two either way\"},{\"slot\":6,\"id\":\"accent\",\"label\":\"Accent\",\"min\":0,\"max\":100,\"unit\":\"%\",\"default\":0,\"rand\":[0,80],\"hint\":\"How far every hit off the beat drops in level, by up to 60%, so the hits on the beat stand out\"}],\"nodes\":[{\"id\":\"decay\",\"op\":\"param\",\"control\":\"decay\"},{\"id\":\"tone\",\"op\":\"param\",\"control\":\"tone\"},{\"id\":\"metal\",\"op\":\"param\",\"control\":\"metal\"},{\"id\":\"pitch\",\"op\":\"param\",\"control\":\"pitch\"},{\"id\":\"vary\",\"op\":\"param\",\"control\":\"vary\"},{\"id\":\"accent\",\"op\":\"param\",\"control\":\"accent\"},{\"id\":\"roll\",\"op\":\"dice\"},{\"id\":\"centered\",\"op\":\"sub\",\"b\":0.5},{\"id\":\"v_amt\",\"op\":\"mul\",\"b\":0.02},{\"id\":\"v_oct\",\"op\":\"mul\"},{\"id\":\"v_ratio\",\"op\":\"exp2\"},{\"id\":\"dec_v\",\"op\":\"mul\"},{\"id\":\"step_no\",\"op\":\"step_index\"},{\"id\":\"in_beat\",\"op\":\"mod\",\"b\":4},{\"id\":\"off\",\"op\":\"gt\"},{\"id\":\"a_amt\",\"op\":\"mul\",\"b\":-0.006},{\"id\":\"a_off\",\"op\":\"mul\"},{\"id\":\"a_gain\",\"op\":\"add\",\"a\":1},{\"id\":\"accented\",\"op\":\"mul\"},{\"id\":\"hit\",\"op\":\"trig\"},{\"id\":\"hz\",\"op\":\"note\",\"base\":60},{\"id\":\"root\",\"op\":\"mtof\",\"in\":60},{\"id\":\"ratio\",\"op\":\"div\"},{\"id\":\"f0\",\"op\":\"mul\"},{\"id\":\"f1\",\"op\":\"mul\",\"b\":1.483},{\"id\":\"f2\",\"op\":\"mul\",\"b\":1.8},{\"id\":\"f3\",\"op\":\"mul\",\"b\":2.546},{\"id\":\"f4\",\"op\":\"mul\",\"b\":2.63},{\"id\":\"f5\",\"op\":\"mul\",\"b\":3.897},{\"id\":\"o0\",\"op\":\"pulse\"},{\"id\":\"o1\",\"op\":\"pulse\"},{\"id\":\"o2\",\"op\":\"pulse\"},{\"id\":\"o3\",\"op\":\"pulse\"},{\"id\":\"o4\",\"op\":\"pulse\"},{\"id\":\"o5\",\"op\":\"pulse\"},{\"id\":\"cluster\",\"op\":\"mul\",\"b\":0.18},{\"id\":\"noise\",\"op\":\"noise\"},{\"id\":\"hiss\",\"op\":\"mono\"},{\"id\":\"hiss_lvl\",\"op\":\"mul\",\"b\":0.45},{\"id\":\"blend\",\"op\":\"mul\",\"b\":0.01},{\"id\":\"src\",\"op\":\"mix\"},{\"id\":\"t_hz\",\"op\":\"mul\"},{\"id\":\"hp1\",\"op\":\"svf\",\"mode\":\"hp\",\"q\":0.8},{\"id\":\"hp2\",\"op\":\"svf\",\"mode\":\"hp\",\"q\":0.6},{\"id\":\"tau\",\"op\":\"div\",\"b\":6.9078},{\"id\":\"ring\",\"op\":\"slide\",\"up\":0},{\"id\":\"vca\",\"op\":\"mul\"},{\"id\":\"level\",\"op\":\"mul\",\"b\":1.3},{\"id\":\"faded\",\"op\":\"lt\",\"b\":0.0001},{\"id\":\"end\",\"
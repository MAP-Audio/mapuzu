-- @title Night Shift
-- @by mapuzu
-- @genre techno
-- @preset night-shift.preset
-- @cycles 88
-- @license CC0-1.0 (code)
--
-- night-shift.strudel.js in TidalCycles: every note is written here, and PAM is the sound engine.

{-
Setup, in this order:
  1. PAM: load night-shift.preset, import night-shift.midimap.json (Settings > Mappings > Import),
     and give PAM a MIDI input port. The preset has cell N on MIDI channel N, so play PAM
     standalone or in a host that keeps channels apart. Nothing else needs switching on.
  2. Run `mapuzu tidal` and leave the page it prints open: that page sends the MIDI.
  3. Load mapaudio.tidal in BootTidal.hs: `mapuzu tidal` prints the lines, for Tidal 1.9 and 1.10.
  4. Evaluate the `once $ pamsetup` line, then the `do` block.
Note names sit an octave above Strudel's: Tidal's c5 is middle C, which Strudel calls c4.
-}

once $ pamsetup "channels=cell poly=5,7,8 roots=5:36,7:48,8:48 names=bd:1,cp:2,hh:3,oh:4,acid:5,perc:6,stab:7,pad:8"

-- timeline (cycles): intro 0-8 | groove 8-24 | acid 24-40 | break 40-48 | build 48-56 | drop 56-80 | outro 80-88
do
  let -- drums
      bd     = pam "bd*4" # velocity "1 0.88 0.94 0.88"
      bdx    = (struct "t ~ ~ ~ t ~ ~ ~ t ~ ~ ~ t ~ [~ t] ~" $ pam "bd") # velocity 0.95
      roll   = (struct "t*4 t*4 t*8 t*16" $ pam "bd") # velocity (range 0.45 1 saw)
      cp     = pam "~ cp" # velocity "<0.8 0.8 0.8 [0.8 0.5]>"
      hh     = pam "hh*16" # velocity "[0.55 0.22 0.7 0.22]*4"
                 # knob "synth_p2" "<0.2!3 [0.2 0.2 0.2 0.34]>"
      oh     = pam "[~ oh]*4" # velocity 0.7
      perc   = (struct "~ t ~ [~ t] ~ ~ t ~ ~ [t ~] ~ t ~ ~ [~ t] ~" $ pam "perc") # velocity "[0.7 0.5 0.9]/2"
                 # knob "synth_p1" "<0.4 0.4 0.52 0.34>"
      -- acid: one bar of eighths, turned by the cutoff and the envelope over the long arcs
      line   = "<[c3 c3 c4 c3 ef3 c3 c4 g3] [c3 c3 c4 c3 ef3 c3 bf3 c4] [c3 c3 c4 c3 ef3 c3 c4 g3] [f3 f3 f4 f3 af3 f3 ef4 f4]>"
      acid   = note line # pam "acid" # legato 0.55
                 # velocity "[0.7 0.5 1 0.5 0.8 0.5 1 0.6]"
      acid16 = (ply "<1 1 2 [1 2]>" $ note line # pam "acid") # legato 0.5
                 # velocity "[0.75 0.5 1 0.5]*2"
      -- stabs and pad, in C minor
      stab   = note "<[~ [c5,ef5,g5]] ~ [~ [c5,ef5,g5]] [~ [bf4,d5,f5]]>" # pam "stab" # legato 0.4 # velocity 0.8
      stab2  = note "[~ [c5,ef5,g5]]*2 [~ [c5,ef5,g5]] <[~ [bf4,d5,f5]] [[af4,c5,ef5] ~]>" # pam "stab" # legato 0.35 # velocity 0.85
      pad    = note "<[c4,g4,ef5] [c4,g4,ef5] [af3,ef4,c5] [bf3,f4,d5]>/2" # pam "pad" # velocity 0.6
  setcps (132/60/4)
  resetCycles
  d1 $ stack [
      --             intro   groove   acid    break   build   drop     outro
      mask         "<t@8     t@16     t@16    f@8     f@8     t@24     t@4 f@4>" bd,
      mask         "<f@8     f@16     f@16    f@8     t@6 f@2 f@24     f@8>" bdx,
      mask         "<f@8     f@16     f@16    f@8     f@7 t   f@24     f@8>" roll,
      mask         "<f@8     t@16     t@16    f@8     f@8     t@24     f@8>" cp,
      mask         "<f@4 t@4 t@16     t@16    f@8     t@8     t@24     t@8>" hh,
      mask         "<f@8     f@8 t@8  t@16    f@8     f@8     t@24     f@8>" oh,
      mask         "<f@8     t@16     t@16    t@8     t@8     t@24     t@8>" perc,
      mask         "<f@8     f@16     t@16    t@8     f@8     f@24     f@8>" acid,
      mask         "<f@8     f@16     f@16    f@8     t@8     t@24     f@8>" acid16,
      mask         "<f@8     f@8 t@8  t@16    t@8     f@8     f@24     t@8>" stab,
      mask         "<f@8     f@16     f@16    f@8     f@8     t@24     f@8>" stab2,
      mask         "<t@8     f@16     f@16    t@8     t@8     f@8 t@16 t@8>" pad,
      -- knobs: the acid filter opens through the acid section, closes for the break, and rides the drop
      knob "cmi_p1" "<0.24@24 0.24 0.28 0.32 0.36 0.4 0.44 0.48 0.52 0.56 0.6 0.64 0.68 0.72 0.76 0.8 0.84 0.5@8 0.3 0.36 0.42 0.48 0.54 0.6 0.7 0.8 0.66@24 0.4@8>" # cell "acid",
      knob "cmi_p3" "<0.6@24 0.6@16 0.45@8 0.5@8 0.78@24 0.6@8>" # cell "acid",
      knob "delayMix" "<0@24 12@16 40@8 10@8 18@24 0@8>" # cell "acid",
      -- the pad's brightness rises and falls with the sections
      knob "cmi_p2" "<0.35@8 0.45@32 0.7@8 0.8@8 0.5@24 0.3@8>" # cell "pad"
    ]

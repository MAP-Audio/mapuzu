wn, held or not.\",\"factory\":\"fm_bell\",\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"lineage\":\"i_fm_bell\",\"name\":\"FM Bell\",\"nodes\":[{\"control\":\"ratio\",\"id\":\"ratio\",\"op\":\"param\"},{\"control\":\"index\",\"id\":\"index\",\"op\":\"param\"},{\"control\":\"decay\",\"id\":\"decay\",\"op\":\"param\"},{\"control\":\"tune\",\"id\":\"tune\",\"op\":\"param\"},{\"a\":60,\"id\":\"root\",\"op\":\"add\"},{\"id\":\"hz\",\"op\":\"note\"},{\"id\":\"mod_hz\",\"op\":\"mul\"},{\"id\":\"mod\",\"op\":\"cycle\"},{\"id\":\"hit\",\"op\":\"trig\"},{\"b\":6.9078,\"id\":\"tau\",\"op\":\"div\"},{\"id\":\"ring\",\"op\":\"slide\",\"up\":0},{\"id\":\"shine\",\"op\":\"slide\",\"up\":0},{\"b\":0.35,\"id\":\"shine_time\",\"op\":\"mul\"},{\"b\":0.159155,\"id\":\"depth\",\"op\":\"mul\"},{\"id\":\"sweep\",\"op\":\"mul\"},{\"id\":\"pm\",\"op\":\"mul\"},{\"id\":\"carrier\",\"op\":\"cycle\"},{\"id\":\"amp\",\"op\":\"mul\"},{\"b\":0.35,\"id\":\"level\",\"op\":\"mul\"},{\"b\":0.0001,\"id\":\"faded\",\"op\":\"lt\"},{\"id\":\"end\",\"op\":\"done\"},{\"id\":\"ring_s\",\"ms\":0.3,\"op\":\"slide\"}],\"retired\":[],\"ui\":{\"sections\":[{\"label\":\"Operators\",\"widgets\":[{\"type\":\"xy\",\"x\":\"ratio\",\"y\":\"index\"}]},{\"label\":\"Ring\",\"widgets\":[{\"control\":\"decay\",\"size\":\"l\",\"type\":\"knob\"},{\"control\":\"tune\",\"type\":\"knob\"},{\"type\":\"spectrum\"}]}]},\"voices\":8}","cell7_cmiLayout":"","cell7_cmiMute":0,"cell7_cmiVolume":3,"cell7_cmi_p1":0.5,"cell7_cmi_p10":0.5,"cell7_cmi_p11":0.5,"cell7_cmi_p12":0.5,"cell7_cmi_p13":0.5,"cell7_cmi_p14":0.5,"cell7_cmi_p15":0.5,"cell7_cmi_p16":0.5,"cell7_cmi_p17":0.5,"cell7_cmi_p18":0.5,"cell7_cmi_p19":0.5,"cell7_cmi_p2":0.28,"cell7_cmi_p20":0.5,"cell7_cmi_p21":0.5,"cell7_cmi_p22":0.5,"cell7_cmi_p23":0.5,"cell7_cmi_p24":0.5,"cell7_cmi_p3":0.55,"cell7_cmi_p4":0.5,"cell7_cmi_p5":0.5,"cell7_cmi_p6":0.5,"cell7_cmi_p7":0.5,"cell7_cmi_p8":0.5,"cell7_cmi_p9":0.5,"cell7_codecBitrate":64,"cell7_codecCentre":2000,"cell7_codecEnabled":0,"
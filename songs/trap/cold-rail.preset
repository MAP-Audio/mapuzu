mfx_p18":0.5,"cell8_cmfx_p19":0.5,"cell8_cmfx_p2":0.5,"cell8_cmfx_p20":0.5,"cell8_cmfx_p21":0.5,"cell8_cmfx_p22":0.5,"cell8_cmfx_p23":0.5,"cell8_cmfx_p24":0.5,"cell8_cmfx_p3":0.5,"cell8_cmfx_p4":0.5,"cell8_cmfx_p5":0.5,"cell8_cmfx_p6":0.5,"cell8_cmfx_p7":0.5,"cell8_cmfx_p8":0.5,"cell8_cmfx_p9":0.5,"cell8_cmi":"{\"cables\":[[\"motion\",\"breath.freq\"],[\"breath\",\"swing\"],[\"shimmer\",\"rad\"],[\"rad\",\"index\"],[\"swing\",\"index.b\"],[\"hz\",\"mod_hz\"],[\"ratio\",\"mod_hz.b\"],[\"mod_hz\",\"mod.freq\"],[\"mod\",\"pm\"],[\"index\",\"pm.b\"],[\"hz\",\"carrier.freq\"],[\"pm\",\"carrier.phase\"],[\"hz\",\"hi_hz\"],[\"hi_hz\",\"hi_mod_hz\"],[\"ratio\",\"hi_mod_hz.b\"],[\"hi_mod_hz\",\"hi_mod.freq\"],[\"hi_mod_hz\",\"top\"],[\"top\",\"fade\"],[\"index\",\"hi_idx\"],[\"hi_mod\",\"hi_pm\"],[\"hi_idx\",\"hi_pm.b\"],[\"hi_hz\",\"hi_car.freq\"],[\"hi_pm\",\"hi_car.phase\"],[\"fade\",\"hi_gain\"],[\"hi_car\",\"hi_lvl\"],[\"hi_gain\",\"hi_lvl.b\"],[\"hi_lvl\",\"hi_pan\"],[\"carrier\",\"low_pan\"],[\"low_pan\",\"sum\"],[\"hi_pan\",\"sum.b\"],[\"sum\",\"mirror\"],[\"index_v\",\"odd\"],[\"odd\",\"facing.cond\"],[\"mirror\",\"facing.a\"],[\"sum\",\"facing.b\"],[\"facing\",\"ap1\"],[\"t1\",\"ap1.time\"],[\"ap1\",\"ap2\"],[\"t2\",\"ap2.time\"],[\"halo\",\"halo_t\"],[\"facing\",\"haze.a\"],[\"ap2\",\"haze.b\"],[\"halo_t\",\"haze.t\"],[\"vel\",\"touch\"],[\"held\",\"target\"],[\"touch\",\"target.b\"],[\"target\",\"late\"],[\"attack\",\"rise\"],[\"release\",\"fall\"],[\"late\",\"env\"],[\"rise\",\"env.up\"],[\"fall\",\"env.down\"],[\"haze\",\"vca\"],[\"env\",\"vca.b\"],[\"vca\",\"level\"],[\"level\",\"out\"]],\"controls\":[{\"default\":1.4,\"hint\":\"Peak depth of the modulator's bend on the carrier, which breathes between 40% and 100% of it at Motion\",\"id\":\"shimmer\",\"label\":\"Shimmer\",\"max\":4,\"min\":0,\"rand\":[0.5,3],\"slot\":1},{\"default\":3,\"hint\":\"Pitch of the modulating sine, in multiples of the note\",\"id\":\"ratio\",\"label\":\"Ratio\",\"labels\":[\"2:1\",\"3:1\",\"4:1\",\"5:1\",\"7:1\"],\"morph\":\"snap\",\"slot\":2,\"values\":[2,3,4,5,7]},{\"curve\":\"exp\",\"default\":0.3,\"hint\":\"Speed at which the bend breathes in and out\",\"id\":\"motion\",\"label\":\"Motion\",\"max\":4,\"min\":0.05,\"rand\":[0.1,1.5],\"slot\":3,\"unit\":\"Hz\"},{\"curve\":\"exp\",\"default\":400,\"hint\":\"Time for a note to swell to full level\",\"id\":\"attack\",\"label\":\"Attack\",\"max\":5000,\"min\":5,\"rand\":[150,2500],\"slot\":4,\"unit\":\"ms\"},{\"curve\":\"exp\",\"default\":1500,\"hint\":\"Time for a note to fall 60 dB once it is let go\",\"id\":\"release\",\"label\":\"Release\",\"max\":8000,\"min\":50,\"rand\":[500,5000],\"slot\":5,\"unit\":\"ms\"},{\"default\":40,\"hint\":\"Blend of two allpass diffusers, set to different times on each side, which smear each note\",\"id\":\"halo\",\"label\":\"Halo\",\"max\":100,\"min\":0,\"rand\":[0,80],\"slot\":6,\"unit\":\"%\"}],\"description\":\"A glassy FM pad. A sine at Ratio times the note bends the phase of a sine at the key's pitch by Shimmer, and the bend breathes slowly at Motion. A second pair, an octave up and a few cents sharp, is panned to one side, and every other voice mirrors the image left for right. Halo blends in two allpass diffusers, set to different times on each side, which smear each note. Each note swells over Attack, holds while the key is down and falls 60 dB over Release once let go. A harder strike plays a little louder.\",\"factory\":\"glass_pad\",\"format\":\"cmfx/1\",\"kind\":\"instrument\",\"lineage\":\"i_glass_pad\",\"name\":\"Glass Pad\",\"nodes\":[{\"control\":\"shimmer\",\"id\":\"shimmer\",\"op\":\"param\"},{\"control\":\"ratio\",\"id\":\"ratio\",\"op\":\"param\"},{\"control\":\"motion\",\"id\":\"motion\",\"op\":\"param\"},{\"control\":\"attack\",\"id\":\"attack\",\"op\":\"param\"},{\"control\":\"release\",\"id\":\"release\",\"op\":\"param\"},{\"control\":\"halo\",\"id\":\"halo\",\"op\":\"param\"},{\"base\":48,\"id\":\"hz\",\"op\":\"note\"},{\"id\":\"breath\"
-- @title Cold Rail
-- @by mapuzu
-- @genre trap
-- @preset cold-rail.preset
-- @cycles 76
-- @license CC0-1.0 (code)
--
-- cold-rail.strudel.js in TidalCycles. Both at once: PAM plays the hats, open hat and rim from its
-- own patterns, a different set in each variation, and Tidal chooses the variation, mutes and turns
-- knobs. Kick, clap, 808 and the two CMI instruments are written here.

{-
Setup, in this order:
  1. PAM: load cold-rail.preset, import cold-rail.midimap.json (Settings > Mappings > Import), and
     give PAM a MIDI input port. The preset has cell N on MIDI channel N.
  2. PAM plays its own patterns here, so it follows Tidal's clock: use a standalone PAM and switch
     External Clock Sync on. The `do` block sends the clock from d1.
  3. Run `mapuzu tidal` and leave the page it prints open: that page sends the MIDI.
  4. Load mapaudio.tidal in BootTidal.hs: `mapuzu tidal` prints the lines, for Tidal 1.9 and 1.10.
  5. Evaluate the `once $ pamsetup` line, then the `do` block.
Note names sit an octave above Strudel's: Tidal's c5 is middle C, which Strudel calls c4.
-}

once $ pamsetup "channels=cell poly=5,7,8 roots=5:36,7:60,8:48 names=bd:1,cp:2,hh:3,oh:4,sub:5,rim:6,bell:7,pad:8"

-- timeline (cycles): intro 0-4 | verse 4-20 | hook 20-36 | break 36-40 | verse 40-56 | hook 56-72 | outro 72-76
do
  let kick  = "<[t ~ ~ ~ ~ ~ t ~ ~ ~ t ~ ~ ~ ~ ~] [t ~ ~ t ~ ~ t ~ ~ ~ ~ ~ t ~ ~ ~]>"
      bd    = (struct kick $ pam "bd") # velocity 0.95
      cp    = pam "~ cp" # velocity "<0.9 0.9 0.9 [0.9 0.6]>"
      sub   = note "<[f2 ~ ~ ~ ~ ~ f2 ~ ~ ~ af2 ~ ~ ~ ~ ~] [f2 ~ ~ f2 ~ ~ ef2 ~ ~ ~ ~ ~ c3 ~ ~ ~] [df2 ~ ~ ~ ~ ~ df2 ~ ~ ~ f2 ~ ~ ~ ~ ~] [ef2 ~ ~ ef2 ~ ~ c2 ~ ~ ~ ~ ~ c3 ~ bf2 ~]>"
                # pam "sub" # legato "<5 4 5 4>" # velocity 0.95
      bell  = note "<[c6 ~ ~ af5 ~ ~ f5 ~] [~ g5 ~ ~ af5 ~ ~ ~] [c6 ~ ~ af5 ~ ~ f5 ~] [~ ef6 ~ c6 ~ ~ af5 g5]>"
                # pam "bell" # legato 1.5 # velocity "[0.8 0.6]*4"
      bell2 = (0.0625 ~>) $ bell |+ note "<12 12 12 [12 0]>" # velocity 0.55
      pad   = note "<[f4,af4,c5] [f4,af4,c5] [df4,f4,af4] [ef4,g4,bf4]>" # pam "pad" # velocity 0.6
  setcps (140/60/4)
  resetCycles
  d1 $ pamclock
  -- PAM's side: variation 1 is plain eighths, 2 adds rolls, 3 is the busy hook, 4 is the break
  d2 $ variation "<4@4 1@8 2@8 3@16 4@4 2@16 3@16 4@4>"
  -- the hats drop out for the bar before each hook, and the rim rests through the intro
  d3 $ knob "mute" "<0@19 1 0@35 1 0@20>" # cell "hh"
  d4 $ knob "mute" "<1@4 0@72>" # cell "rim"
  -- Tidal's side
  d5 $ stack [
      --     intro   verse     hook    break   verse   hook    outro
      mask "<f@4     t@16      t@16    f@4     t@16    t@16    f@4>" bd,
      mask "<f@4     t@16      t@16    f@4     t@16    t@16    f@4>" cp,
      mask "<f@4     t@16      t@16    f@4     t@16    t@16    f@4>" sub,
      mask "<t@4     f@8 t@8   t@16    t@4     t@16    t@16    t@4>" bell,
      mask "<f@4     f@16      t@16    f@4     f@16    t@16    f@4>" bell2,
      mask "<t@4     f@16      t@16    t@4     f@16    t@16    t@4>" pad,
      -- the 808 rings longer in the hooks, and the bell's echo opens in the break and the outro
      knob "synth_p4" "<0.5@20 0.62@16 0.5@20 0.62@16 0.5@4>" # cell "sub",
      knob "delayMix" "<28@36 55@4 28@32 60@4>" # cell "bell"
    ]

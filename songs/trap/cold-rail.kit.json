    "cell7_cmi_p2": 0.28,
    "cell7_cmi_p3": 0.55,
    "cell7_cmiVolume": 3,
    "cell7_volume": -2,
    "cell7_delayEnabled": 1,
    "cell7_delaySyncEnabled": 1,
    "cell7_delayDelayTime": 0.4706,
    "cell7_delayFeedback": 50,
    "cell7_delayMix": 28,
    "cell7_delayPingPong": 1,
    "cell7_fdnEnabled": 1,
    "cell7_fdnMix": 30,
    "cell7_fdnSize": 70,
    "cell7_fdnFeedback": 60,

    "cell8_cmi_p1": 0.3,
    "cell8_cmi_p4": 0.55,
    "cell8_cmi_p5": 0.65,
    "cell8_cmiVolume": 4,
    "cell8_volume": -6,
    "cell8_fdnEnabled": 1,
    "cell8_fdnMix": 40,
    "cell8_fdnSize": 80,
    "cell8_fdnFeedback": 65

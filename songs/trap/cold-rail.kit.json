  "patterns": {
    "3": { "code": "s(\"3\").struct(\"x*8\").velocity(\"[.85 .5 .7 .5]*2\")", "bars": 1 },
    "4": "",
    "6": { "mini": "~ ~ ~ x ~ ~ [~ x] ~", "bars": 2 }
  },
  "variations": {
    "2": {
      "patterns": {
        "3": { "code": "s(\"3\").struct(\"<[x x x x x x [x x x] x] [x x [x x] x x x x*4 x]>\").velocity(\"[.85 .5 .7 .5]*2\")", "bars": 2 },
        "4": { "mini": "<[~ ~ ~ ~ ~ ~ ~ x] ~>", "bars": 2 },
        "6": { "mini": "~ ~ ~ x ~ [~ x] ~ ~", "bars": 1 }
      }
    },
    "3": {
      "patterns": {
        "3": { "code": "s(\"3\").struct(\"<[x*2 x*2 x*2 x*3 x*2 x*2 x*4 x*2] [x*2 x*2 x*6 x*2 x*2 x*3 x*2 x*8]>\").velocity(\"[.85 .45 .65 .45]*4\")", "bars": 2 },
        "4": { "mini": "~ ~ ~ x ~ ~ ~ x", "bars": 1 },
        "6": { "mini": "~ x ~ [~ x] ~ ~ x ~", "bars": 1 }
      }
    },
    "4": {
      "patterns": {
        "3": "",
        "4": "",
        "6": { "mini": "~ ~ ~ ~ ~ ~ x ~", "bars": 2 }
      }
    }
  }

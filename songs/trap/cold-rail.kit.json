    "cell4_synthEngine": "HiHat",
    "cell4_synth_p2": 0.88,
    "cell4_synth_p3": 0.58,
    "cell4_synth_p4": 0.7,
    "cell4_volume": -16.5,
    "cell4_pan": -0.25,

    "cell5_synthEngine": "808",
    "cell5_synth_p2": 0.2,
    "cell5_synth_p4": 0.5,
    "cell5_synth_p5": 0.35,
    "cell5_synthHold": 1,
    "cell5_volume": -8,

    "cell6_synthEngine": "Rim",
    "cell6_synth_p1": 0.6,
    "cell6_synthVolume": 6,
    "cell6_volume": 0,
    "cell6_pan": 0.4,
    "cell6_delayEnabled": 1,
    "cell6_delaySyncEnabled": 1,
    "cell6_delayDelayTime": 0.4706,
    "cell6_delayFeedback": 35,
    "cell6_delayMix": 22,
    "cell6_delayPingPong": 1,


{
  "name": "Cold Rail",
  "tempo": 140,
  "meta": {
    "author": "mapuzu",
    "description": "Trap kit for cold-rail.strudel.js. PAM plays the hats, open hat and rim from its own patterns, a different set in each of four variations; Strudel plays the kick, clap, 808 and the two CMI instruments. Drum synths on cells 1-6, CMI instruments on 7 and 8: it needs no samples."
  },
  "programs": {
    "cmi": { "7": "fm_bell", "8": "glass_pad" }
  },
  "channels": "cell",
  "pitched": [5, 7, 8],
  "state": {
    "masterLimiterEnabled": 1,
    "masterLimiterMode": 1,

    "cell1_synthEngine": "Kick",
    "cell1_synth_p1": 0.3,
    "cell1_synth_p4": 0.4,
    "cell1_synth_p6": 0.4,
    "cell1_volume": 2,

    "cell2_synthEngine": "Clap",
    "cell2_synth_p1": 0.42,
    "cell2_synth_p2": 0.55,
    "cell2_synth_p3": 0.4,
    "cell2_synth_p4": 0.4,
    "cell2_synth_p5": 0.3,
    "cell2_volume": -2,
    "cell2_fdnEnabled": 1,
    "cell2_fdnMix": 22,
    "cell2_fdnSize": 45,
    "cell2_fdnFeedback": 40,

    "cell3_synthEngine": "HiHat",
    "cell3_synth_p2": 0.45,
    "cell3_synth_p3": 0.62,
    "cell3_synth_p4": 0.7,
    "cell3_volume": -12.5,
